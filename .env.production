# This file is actually loaded by Dotenv when RAILS_ENV=production

RACK_ENV=production
RAILS_ENV=production

ASSETS_PRECOMPILE=1

# Hash reasonable time
SCRYPT_MAX_TIME=0.2

# More threads
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=32
PUMA_TIMEOUT=30

MYSQL_DATABASE=ensl
MYSQL_CONNECTION_POOL=48

# Files root
FILES_HOST_ROOT=/srv/ensl/files
EXTRA_HOST_ROOT=/srv/ensl/extra

APP_DOMAIN=ensl.org

# WebAuthn / passkey relying party configuration
WEBAUTHN_RP_NAME=ENSL
WEBAUTHN_RP_ID=ensl.org
WEBAUTHN_ORIGIN=https://ensl.org

GOOGLE_CALENDAR=enabled
