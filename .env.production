# This file is actually loaded by Dotenv when RAILS_ENV=production

RACK_ENV=production
RAILS_ENV=production

ASSETS_PRECOMPILE=1

SCRYPT_MAX_TIME=0.2

# FIXME Disable workers + cluster mode for now. They break start up.
PUMA_WORKERS=0
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=32
PUMA_TIMEOUT=30

MYSQL_DATABASE=ensl
MYSQL_CONNECTION_POOL=48

# Files root
FILES_HOST_ROOT=/srv/ensl/files

APP_DOMAIN=ensl.org

GOOGLE_CALENDAR=enabled
