{
  "name": "Ruby RSpec Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  "runArgs": ["--security-opt=seccomp=unconfined"],

  // Optional but usually correct if your container user is 'web'
  "remoteUser": "web",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ]
    }
  }
}
