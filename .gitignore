# Rails / runtime
/log/*
!log/.placeholder
/tmp/*
!tmp/**/.placeholder
/spec/tmp/*
test*.log
rerun.txt

# Ruby / Bundler
.ruby-version
.ruby-gemset
/.bundle
/vendor/bundle/
.bundle
.rspec
.rakeTasks
.generators

# Environment / local config
.env*.local
.envrc
.tmp*

# Caches / compiled artifacts
.sass-cache
*.sassc
*.rbc

# Dependency directories
node_modules/

# Database / seed data
db_data/*
!db_data/.placeholder
db/data/
!db/data/.placeholder
db/initdb.d/*
!db/initdb.d/.placeholder
!db/initdb.d/*setup*.sql

# Secrets / sync credentials
config/data_file_sync_servers.json

# Infra / deployment local secrets
dkim
ext/dkim
ext/ssl
!ext/ssl/.placeholder

# Nginx (ignore only generated/default file)
ext/nginx.conf.d/default.conf
!ext/nginx.conf.d/.ht*

# Uploaded / generated public assets
/public/system/*
/public/files
/public/local
/public/uploads
/public/assets

# Frontend build output
/app/assets/builds/*
!/app/assets/builds/.keep

# Vendored importmap assets (created at build/startup)
/app/assets/javascripts/vendor

# Editor / IDE files
.vscode/*
!.vscode/launch.json
.idea/
*.sublime*
**.swp

# OS / VCS leftovers
.DS_Store
**.orig

# Coverage / backups / indexes
/coverage*/
/backups
/index/*
pickle-email-*.html

# Debug / tags
.byebug_history
*.tags
*.gemtags

# Local checklist
CHECKLIST.md
