<% captain = team == 1 ? @gather.captain1 : @gather.captain2 %>
<% pick = false %>

<h4>
  <%= if team.nil? then "Lobby" else team == 1 ? "Marines" : "Aliens" end %>
</h4>

<%= form_tag pick_gather_path(@gather), data: { turbo_stream: true } do %>
  <ul class="gatherers" id="<%= team.nil? ? 'lobby-gatherers' : "team-#{team}-gatherers" %>">
    <% @gather.gatherers.ordered.team(team).each do |gatherer| %>
      <li>
          <% if @gatherer and gatherer.can_update? gather_current_user, { team: @gatherer.team } %>
          <% pick = true %>
          <%= radio_button_tag :player, gatherer.id %>
          <%= flag gatherer.user.country %>
          <% captain_flag = if gatherer == @gather.captain1 then 1 elsif gatherer == @gather.captain2 then 2 end %>
          <%= link_to gatherer.user.to_s, gatherer.user, class: 'user', data: (captain_flag ? { captain: captain_flag } : {}) %>

        <% else %>
          <%= flag(gatherer.user.country) if gatherer.user && gatherer.user.country %>

          <% if gatherer == captain and gatherer.team == gatherer.gather.turn %>
            <%= fa_icon 'chevron-right' %>
          <% end %>

          <% captain_flag = if gatherer == @gather.captain1 then 1 elsif gatherer == @gather.captain2 then 2 end %>
          <%= link_to gatherer.user.to_s, gatherer.user, class: 'user', data: (captain_flag ? { captain: captain_flag } : {}) %>

          <% if gatherer == captain %>
            <span class="captain">
              <%= fa_icon('star') %>
            </span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if pick %>
    <div class="controls">
      <%= submit_tag 'Pick' %>
    </div>
  <% end %>
<% end %>
