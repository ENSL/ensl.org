<% captain = team == 1 ? gather.captain1 : gather.captain2 %>
<% pick = false %>
<% gatherers = gather.gatherers.for_pick_list(team) %>
<% current_gatherer = gatherer %>

<%= form_tag(pick_gatherers_path, authenticity_token: false,
             data: { turbo_stream: true, controller: 'gather-pick',
                     gather_pick_gather_id_value: gather.id,
                     action: 'change->gather-pick#rememberSelection submit->gather-pick#clearSelection' }) do %>
  <ul class="gatherers" id="<%= team.nil? ? 'lobby-gatherers' : "team-#{team}-gatherers" %>">
    <% gatherers.each_with_index do |gatherer, index| %>
      <% user = gatherer.user %>
      <% turn = gather.turn %>
      <% team_pick_position = team.nil? ? nil : (index + 1) %>
      <% captain_flag = if gatherer == gather.captain1 then 1 elsif gatherer == gather.captain2 then 2 end %>
      <% pick_order_badge = tag.span(team_pick_position, class: 'pick-order-badge', title: 'Team pick order') if team_pick_position %>
      <li>
          <% if current_gatherer and gatherer.can_update? gather_current_user, { team: current_gatherer.team } %>
          <% pick = true %>
          <%= radio_button_tag :player, gatherer.id %>
          <%= user_identity_link(user, data: (captain_flag ? { captain: captain_flag } : {}), after_flag: pick_order_badge) %>

        <% else %>
          <% identity_detail = [pick_order_badge] %>
          <% if gather.status != Gather::STATE_FINISHED && gatherer == captain and gatherer.team == turn %>
            <% identity_detail << fa_icon('chevron-right') %>
          <% end %>
          <%= user_identity_link(user, data: (captain_flag ? { captain: captain_flag } : {}), after_flag: safe_join(identity_detail.compact, ' ')) %>

          <% if gatherer == captain %>
            <span class="captain">
              <%= fa_icon('star') %>
            </span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if pick %>
    <div class="controls">
      <%= submit_tag 'Pick' %>
    </div>
  <% end %>
<% end %>
