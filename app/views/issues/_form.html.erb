<%= form_for(@issue, html: { class: 'square' }) do |f| %>
  <%= render 'shared/errors', messages: @issue.errors.full_messages %>
  <div class="fields horizontal">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <% if cuser and (cuser.admin? or Issue::allowed_categories(cuser).include?(@issue.category_id)) %>
    <div class="fields horizontal">
      <%= f.label :status %>
      <%= f.select :status, @issue.statuses.invert %>
    </div>
    <div class="fields horizontal">
      <%= f.label :assigned %>
      <% assigned_username = @issue.assigned.present? ? User.find_by(id: @issue.assigned)&.username : nil %>
      <div class="inputs">
        <%= f.text_field :assigned_name, list: 'staff_list', value: assigned_username, placeholder: 'Enter username or pick from list' %>
        <datalist id="staff_list">
          <% staff_usernames = Group.staff.map { |g| g.respond_to?(:user) ? g.user : g }.compact.map(&:username).uniq %>
          <% staff_usernames.each do |uname| %>
            <option value="<%= uname %>"></option>
          <% end %>
        </datalist>
      </div>
    </div>
  <% end %>
  <div class="fields horizontal">
    <%= f.label :category_id %>
    <%= f.select :category_id, Category.domain(Category::DOMAIN_ISSUES).ordered.collect{|c| [c, c.id]} %>
  </div>
  <div class="fields horizontal">
    <%= f.label :text %>
    <%= f.text_area :text, rows: 7 %>
  </div>
  <% if cuser and (cuser.admin? or Issue::allowed_categories(cuser).include?(@issue.category_id)) %>
    <div class="fields horizontal">
      <%= f.label :solution %>
      <%= f.text_area :solution, rows: 7 %>
    </div>
  <% end %>
  <div class="controls">
    <%= f.submit 'Submit' %>
  </div>
  <% unless cuser %>
    <div class="fields horizontal captcha">
      <%= recaptcha_tags %>
    </div>
  <% end %>
<% end %>
