<table class="issues striped">
  <tr>
    <th class="date w-1/4">Created</th>
    <th class="title w-[35%]">Title</th>
    <th class="assigned w-[15%]">Assigned</th>
    <th class="author w-[15%]">Author</th>
    <th class="actions w-[10%] text-right"></th>
  </tr>

  <% issues.each do |issue| %>
    <tr>
      <td><%= issue.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
      <td><%= namelink issue %></td>
      <td><%= namelink issue.assigned %></td>
      <td><%= namelink issue.author %></td>
      <td class="actions w-[10%] text-right">
        <% if issue.can_update? cuser %>
          <%= link_to fa_icon('pencil'), edit_issue_path(issue) %>
        <% end %>
        <% if issue.can_destroy? cuser %>
          <%= link_to fa_icon('times'), issue, confirm: 'Are you sure?', method: :delete %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
