<div class="box wide">
  <h1>
    History for <%= h @article.title %>
</h1>

<% @versions.each do |version| %>
  <% snapshot = @snapshots[version.id] %>
  <div class="indented">
    <div class="left">
      <%= link_to(h((snapshot&.title).presence || @article.title), article_version_url(@article, version)) %>
    </div>
    <div class="right">
      (v<%= @version_numbers[version.id] %>, <%= longtime version.created_at %>)
    </div>
    <div class="clear">
    </div>
  </div>
<% end %>
<br />
</div>
