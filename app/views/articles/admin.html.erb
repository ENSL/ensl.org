<div class="admin articles">
  <h1 class="title">Articles Admin</h1>

  <% @articles.each do |key, articles| %>
    <h3 class="title"><%=h key %></h3>

    <table class="striped">
      <tr>
        <th class="title w-[40%]">Title</th>
        <th class="category w-[20%]">Category</th>
        <th class="created w-[20%]">Created</th>
        <th class="author w-[10%]">Author</th>
        <th class="actions w-[10%] text-right"></th>
      </tr>

      <% for article in articles %>
        <tr>
          <td><%= namelink article %></td>
          <td><%= h article.category %></td>
          <td><%= shorttime article.created_at %></td>
          <td><%= namelink article.user %></td>
          <td class="actions w-[10%] text-right">
            <%= link_to fa_icon('pencil'), edit_article_path(article) %>
            <%= link_to fa_icon('times'), article, confirm: 'Are you sure?', method: :delete %>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>
</div>
