<% editor_enabled = article.text_coding == Article::CODING_HTML %>
<% markdown_guide = link_to 'Markdown guide', 'https://www.markdownguide.org/basic-syntax/', target: '_blank', rel: 'noopener' %>

<div data-controller="article-format"
  data-article-format-html-value="<%= Article::CODING_HTML %>"
  data-action="article:content-changed@window->article-format#contentChanged">
  <h1><%= article.new_record? ? 'New Article' : 'Editing Article' %></h1>

  <%= form_for(article, html: {
        class: 'article square',
        data: article.persisted? ? { article_format_target: 'form' } : {}
      }) do |f| %>
    <% unless article.new_record? %>
      <div class="fields horizontal">
        <%= f.label :text_coding, 'Format' %>
        <div class="inputs">
          <% if article.format_conversion_options.any? %>
            <%= f.select :text_coding,
                         options_for_select(article.format_conversion_options),
                         { include_blank: "#{article.codings.fetch(article.text_coding)} (current)" },
                         data: { article_format_target: 'select', action: 'article-format#convert' } %>
          <% else %>
            <span><%= article.codings.fetch(article.text_coding) %></span>
          <% end %>
          <% if article.text_coding == Article::CODING_MARKDOWN || article.format_conversion_options.any? %>
            <%= markdown_guide %>
          <% end %>
        </div>
      </div>
    <% end %>
  <div id="<%= error_wrapper_id_for(article) %>">
    <%= render 'shared/errors', messages: article.errors.full_messages, container_id: error_container_id_for(article) %>
  </div>

  <div class="fields horizontal">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>
  <% if cuser.admin? %>
    <div class="fields horizontal">
      <%= f.label :status %>
      <%= f.select :status, article.statuses.invert %>
    </div>
  <% end %>
    <% if article.new_record? %>
      <div class="fields horizontal">
        <%= f.label :text_coding, 'Format' %>
        <div class="inputs">
          <%= f.select :text_coding, article.new_article_codings.invert,
                       {}, data: { article_format_target: 'select', action: 'article-format#newFormatChanged' } %>
          <%= markdown_guide %>
        </div>
      </div>
    <% end %>
  <div class="fields horizontal">
    <%= f.label :category_id %>
    <% category_groups = Category.all.group_by { |category| category.domains[category.domain] }
                                 .sort_by { |domain, _categories| domain }
                                 .map { |domain, categories| [domain, categories.sort_by { |category| category.name.downcase }.map { |category| [category.name, category.id] }] } %>
    <%= f.select :category_id, grouped_options_for_select(category_groups, article.category_id) %>
  </div>
  <div class="fields horizontal wide article-editor<%= ' article-editor-loading' if editor_enabled %>"
       data-controller="article-editor"
       data-article-editor-enabled-value="<%= editor_enabled %>"
       data-article-format-target="editor"
       data-action="article:file-added@window->article-editor#insertFile">
    <h4>Content</h4>
    <%= f.text_area :text, class: 'tinymce', rows: 30, cols: 80,
                 data: { action: 'input->article-format#contentChanged' } %>
    <div class="article-editor-status" role="status">Loading editor...</div>
    <noscript><style>.article-editor-loading textarea { visibility: visible !important; }</style></noscript>
  </div>
  <div class="controls inline">
    <%= f.submit %>
  </div>
  <% end %>
</div>

<% unless article.new_record? %>
  <div class="files">
    <h4>Files</h4>

    <div id="article_files">
      <%= render partial: "data_files/list", locals: { files: article.files } %>
    </div>

    <% if file && file.can_create?(cuser) %>
      <h4>New File</h4>
      <%= render 'data_files/article_upload_form', file: file %>
    <% end %>
  </div>
<% end %>
