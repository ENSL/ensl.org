<div class="article">
  <h3>Version <%= @version_number %></h3>
  <div class="box">
    <% if @snapshot.text_coding == Article::CODING_HTML %>
      <%= sanitize_article_content(@snapshot.text) %>
    <% else %>
      <%= sanitize_article_content(@snapshot.text_parsed) %>
    <% end %>
  </div>
  <% if @article.can_update? cuser %>
    <%= link_to "Revert", article_version_url(@article, @version), :method => :put %>
  <% end %>
</div>
