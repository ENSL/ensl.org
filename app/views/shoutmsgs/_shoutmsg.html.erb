<div class="shoutmsg">
  <div class="user">
      <span class="username">
      <% display_user = local_assigns[:user] || shoutmsg.user %>
      <% if display_user && display_user.respond_to?(:id) && display_user.id.present? %>
        <%= namelink(display_user) %>
      <% else %>
        <%= h(display_user.to_s) %>
      <% end %>
    </span>
    <span class="time">
      <% timestamp = shoutmsg.created_at || Time.current %>
      <% timestamp_format = shoutmsg.shoutable_type == 'Gather' && timestamp.to_date != Time.zone.today ? '%b %d, %H:%M' : '%H:%M' %>
      <%= local_time(timestamp, format: timestamp_format) %>
    </span>
  </div>
  <div class="message">
    <div class="contents">
      <%= auto_link emojify_aliases(shoutmsg.text), html: { target: '_blank' } %>
      <% if local_assigns.key?(:cuser) && shoutmsg.can_destroy?(local_assigns[:cuser]) %>
        <%= link_to fa_icon('times'), shoutmsg, method: :delete, class: 'destroy' %>
      <% end %>
    </div>
  </div>
</div>
