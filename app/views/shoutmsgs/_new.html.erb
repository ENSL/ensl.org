<% rules_link_rendered = false %>
<% if cuser %>
  <% if cuser.banned? Ban::TYPE_MUTE %>
    You have been muted.
  <% else %>
    <%= form_with(model: shoutmsg, id: "new_#{shoutmsg.domain}", html: { class: 'new-shout', data: { turbo: true, controller: 'shout-form' } }, local: false) do |f| %>
      <% if shoutmsg.shoutable %>
        <%= f.hidden_field :shoutable_type %>
        <%= f.hidden_field :shoutable_id %>
      <% end %>
      <div class="fields">
        <%= f.text_field :text, size: 12, id: "#{shoutmsg.domain}_text", class: "shout_input",
              data: { shout_form_target: "input", action: "keyup->shout-form#updateInputState change->shout-form#updateInputState" } %>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      </div>
      <div class="controls">
        <%= button_tag "Shout!", type: 'submit', class: 'shout-submit' %>
        <% if local_assigns[:show_rules_link] %>
          <%= link_to "Shoutbox Rules", article_path(Article::SB_RULES), class: 'shoutbox-rules' %>
          <% rules_link_rendered = true %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if local_assigns[:show_rules_link] && !rules_link_rendered %>
  <%= link_to "Shoutbox Rules", article_path(Article::SB_RULES), class: 'shoutbox-rules' %>
<% end %>

