<p class="rounds-archive__count"><%= pluralize(rounds.total_entries, 'round') %></p>
<table class="data rounds-archive__table">
  <tr>
    <th>Start</th>
    <th>Server</th>
    <th>Map</th>
    <th>Result</th>
    <th>Length</th>
    <th>Players</th>
  </tr>

  <% rounds.each do |round| %>
    <tr class="<%= cycle('even', 'odd') %>">
      <td><%= link_to (round.start_time ? shorttime(round.start_time) : 'n/a'), round %></td>
      <td><%= h round.server_name %></td>
      <td><%= h round.map_name %></td>
      <td><%= h round.winner_s %></td>
      <td><%= h round.length || 'n/a' %></td>
      <td><%= round.rounders.size %></td>
    </tr>
  <% end %>
</table>

<%= will_paginate rounds %>

