<%# WIP: minimal placeholder pending rework for the new Round schema (see RoundsController). %>
<div class="wide box">
  <h1>
    <%= h @round.server_name %> : <%= @round.start_time ? longtime(@round.start_time) : 'n/a' %>
  </h1>
</div>

<div class="wide box">
  <h2 class="center">
    General Info
  </h2>

  <div class="wide center">
    <%= cascade @round, ["winner_s", "length", "map_name"] %>
  </div>
</div>

<div class="wide box">
  <h2 class="center">
    Players
  </h2>

  <table class="data">
    <tr>
      <th>Steam ID</th>
      <th>ENSL</th>
      <th>Team</th>
      <th>Share</th>
    </tr>
    <% @round.rounders.each do |rounder| %>
      <tr>
        <td><%= h rounder.steamid %></td>
        <td><%= namelink rounder.user if rounder.user %></td>
        <td><%= rounder.team == Rounder::TEAM_MARINES ? 'Marines' : 'Aliens' %></td>
        <td><%= number_to_percentage(rounder.share.to_f * 100, precision: 0) if rounder.share %></td>
      </tr>
    <% end %>
  </table>
</div>

