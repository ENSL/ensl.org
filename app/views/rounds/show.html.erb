<div class="round-full">
  <header class="round-full__header">
    <p class="round-full__eyebrow">Round archive</p>
    <h1><%= h @round.server_name %></h1>
    <% if @round.start_time %>
      <p class="round-full__byline"><%= longtime(@round.start_time) %></p>
    <% end %>
  </header>

  <div class="round-full__meta">
    <% winner_class = { Round::RESULT_MARINE_WIN => 'marine', Round::RESULT_ALIEN_WIN => 'alien' }[@round.result] %>
    <div class="round-full__stat round-full__stat--<%= winner_class %>">
      <span class="round-full__stat-value"><%= @round.winner_s || '–' %></span>
      <span class="round-full__stat-label">Winner</span>
    </div>
    <div class="round-full__stat">
      <span class="round-full__stat-value"><%= @round.length || '–' %></span>
      <span class="round-full__stat-label">Length</span>
    </div>
    <div class="round-full__stat">
      <span class="round-full__stat-value"><%= @round.map_name.presence || '–' %></span>
      <span class="round-full__stat-label">Map</span>
    </div>
  </div>

  <section class="round-full__card">
    <h2>Players</h2>

    <% player_names = round_timeline_names(@log_lines) %>
    <% marines, aliens = @round.rounders.partition { |rounder| rounder.team == Rounder::TEAM_MARINES } %>
    <% player_stats = round_player_stats(@round.rounders, @log_lines) %>
    <% marines.sort_by! { |rounder| [-player_stats[rounder.steamid][:kd_ratio], rounder.steamid] } %>
    <% aliens.sort_by! { |rounder| [-player_stats[rounder.steamid][:kd_ratio], rounder.steamid] } %>
    <div class="round-full__player-tables">
      <div class="round-full__player-table">
        <h3>Marines</h3>
        <table class="data round-full__players-table round-full__players-table--marines">
          <colgroup>
            <col class="round-full__player-name-column">
            <col class="round-full__ensl-name-column">
            <col class="round-full__steamid-column">
            <col class="round-full__share-column">
            <col class="round-full__number-column" span="3">
          </colgroup>
          <tr>
            <th>In-game name</th>
            <th>ENSL username</th>
            <th>Steam ID</th>
            <th>Share</th>
            <th>K</th>
            <th>D</th>
            <th>K/D</th>
          </tr>
          <% marines.each do |rounder| %>
            <% stats = player_stats[rounder.steamid] %>
            <tr>
              <td class="round-full__player-name"><%= h(player_names[rounder.steamid] || rounder.steamid) %></td>
              <td class="round-full__ensl-name"><% if rounder.user %><span class="round-full__ensl-identity"><%= flag(rounder.user.country) %><%= namelink(rounder.user) %></span><% else %>-<% end %></td>
              <td><%= h(User.normalize_steamid(rounder.steamid) || rounder.steamid) %></td>
              <td><%= number_to_percentage(rounder.share.to_f * 100, precision: 0) if rounder.share %></td>
              <td><%= stats[:kills] %></td>
              <td><%= stats[:deaths] %></td>
              <td><%= stats[:kd_ratio].infinite? ? '-' : number_with_precision(stats[:kd_ratio], precision: 2) %></td>
            </tr>
          <% end %>
        </table>
      </div>

      <div class="round-full__player-table">
        <h3>Aliens</h3>
        <table class="data round-full__players-table round-full__players-table--aliens">
          <colgroup>
            <col class="round-full__player-name-column">
            <col class="round-full__ensl-name-column">
            <col class="round-full__steamid-column">
            <col class="round-full__share-column">
            <col class="round-full__number-column" span="5">
          </colgroup>
          <tr>
            <th>In-game name</th>
            <th>ENSL username</th>
            <th>Steam ID</th>
            <th>Share</th>
            <th>K</th>
            <th>D</th>
            <th>K/D</th>
            <th>RTs</th>
            <th>Res</th>
          </tr>
          <% aliens.each do |rounder| %>
            <% stats = player_stats[rounder.steamid] %>
            <tr>
              <td class="round-full__player-name"><%= h(player_names[rounder.steamid] || rounder.steamid) %></td>
              <td class="round-full__ensl-name"><% if rounder.user %><span class="round-full__ensl-identity"><%= flag(rounder.user.country) %><%= namelink(rounder.user) %></span><% else %>-<% end %></td>
              <td><%= h(User.normalize_steamid(rounder.steamid) || rounder.steamid) %></td>
              <td><%= number_to_percentage(rounder.share.to_f * 100, precision: 0) if rounder.share %></td>
              <td><%= stats[:kills] %></td>
              <td><%= stats[:deaths] %></td>
              <td><%= stats[:kd_ratio].infinite? ? '-' : number_with_precision(stats[:kd_ratio], precision: 2) %></td>
              <td><%= stats[:resource_towers] %></td>
              <td><%= stats[:resources_spent] %></td>
            </tr>
          <% end %>
        </table>
      </div>
    </div>
  </section>

  <section class="round-full__card">
    <h2>Timeline</h2>

    <% timeline_events = round_timeline_events(@round, @log_lines) %>
    <% if timeline_events.empty? %>
      <p class="center">No event log has been imported for this round yet.</p>
    <% else %>
      <div class="round-timeline-legend">
        <span class="round-timeline-legend-item round-timeline-legend-item--marine">Marines</span>
        <span class="round-timeline-legend-item round-timeline-legend-item--alien">Aliens</span>
      </div>

      <div class="round-timeline" style="height: <%= round_timeline_height(timeline_events) %>px;">
        <div class="round-timeline-spine"></div>
        <% timeline_events.each do |event| %>
          <div class="round-timeline-row round-timeline-row--<%= event[:side] %>" style="top: <%= event[:top] %>px;">
            <div class="round-timeline-side round-timeline-side--marine">
              <% if event[:side] == 'marine' %>
                <div class="round-timeline-card">
                  <span class="round-timeline-time"><%= event[:time_label] %></span><%= h event[:description] %>
                </div>
              <% end %>
            </div>

            <div class="round-timeline-marker">
              <% if event[:side] == 'neutral' %>
                <div class="round-timeline-card round-timeline-card--neutral">
                  <span class="round-timeline-time"><%= event[:time_label] %></span><%= h event[:description] %>
                </div>
              <% else %>
                <span class="round-timeline-dot"></span>
              <% end %>
            </div>

            <div class="round-timeline-side round-timeline-side--alien">
              <% if event[:side] == 'alien' %>
                <div class="round-timeline-card">
                  <span class="round-timeline-time"><%= event[:time_label] %></span><%= h event[:description] %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>

