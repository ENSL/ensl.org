<h3>
  <%= bracket.name if !bracket.name&.empty? and !defined? edit %>
</h3>

<% slots = (bracket.slots || 0).to_i %>
<% if slots <= 0 %>
  <p class="notice">Bracket not configured.</p>
<% else %>
  <% is_edit = defined?(edit) %>
  <% rows = slots*2-1 %>
  <% cols = [(slots - 1).bit_length + 1, 2].max %>
  <div class="bracket-wrapper">
    <table class="brackets">
    <% (0..rows).each do |row| %>
    <tr>
      <% (0...cols).each do |col| %>
        <% bracketer = bracket.get_bracketer(row, col) %>
        <% cell_class = bracket_cell_class(bracket, bracketer, row, col, cols, is_edit) %>
        <td class="<%= cell_class %>">
        <% if bracket_cell_team?(row, col) %>
          <% if is_edit %>
            <%= select_tag "cell[#{row}][#{col}]", options_for_select(bracket.options, :selected => bracket.default(row, col)), { :style => "width: 100%; box-sizing: border-box; margin-bottom: 4px;" } %>
            <div>
              <%= text_field_tag "cell_custom[#{row}][#{col}]", bracketer&.custom_text || '', placeholder: "Custom text", style: "width: 100%; font-size: 0.7em; box-sizing: border-box;" %>
            </div>
          <% elsif bracket_show_content?(bracketer) %>
            <% if bracketer.match %>
              <div class="team-content"><%= link_to bracketer, bracketer.match %></div>
            <% elsif bracketer.contester %>
              <div class="team-content"><%= link_to bracketer.contester.team.name, bracketer.contester %></div>
            <% elsif bracketer.custom_text.present? %>
              <div class="team-content" style="font-size: 0.9em; color: #666;"><%= bracketer.custom_text %></div>
            <% end %>
          <% end %>
        <% end %>
          </td>
      <% end %>
    </tr>
  <% end %>
    </table>
  </div>
<% end %>
