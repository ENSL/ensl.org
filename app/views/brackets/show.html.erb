<div class="wide box">
  <div class="bracket-container">
    <%= render "bracket", bracket: @bracket, edit: false %>
  </div>

  <div class="controls">
    <% if cuser&.admin? %>
      <%= link_to 'Edit Bracket', edit_bracket_path(@bracket), class: 'button' %>
    <% end %>
    <%= link_to 'Contest', edit_contest_path(@bracket.contest), class: 'button' %>
  </div>
</div>
<!-- Inline bracket CSS removed — styles are provided by theme stylesheets under app/assets/stylesheets/themes/ -->
