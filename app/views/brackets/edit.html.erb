<h1 class="title">Editing Bracket</h1>

<div class="wide box">
  <%= form_for(@bracket) do |f| %>
    <%= render 'shared/errors', messages: @bracket.errors.full_messages %>

    <div class="fields">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>

    <div class="fields">
      <%= f.label :slots %>
      <%= f.text_field :slots %>
    </div>

    <%= render "bracket", bracket: @bracket, edit: true %>

    <div class="controls">
      <%= f.submit 'Update' %>
      <%= link_to 'Show', @bracket, class: 'button' %>
    </div>
  <% end %>
</div>
