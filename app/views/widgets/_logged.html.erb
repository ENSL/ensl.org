<div class="logged">
  <%# Hidden current username for JS/selectors and accessibility %>
  <span id="current_user" class="invisible"><%= h(cuser.username) %></span>
  <div class="links">
    <ul>
      <% if cuser.admin? %>
        <li>
          <%= link_to '/about/adminpanel', class: 'admin' do %>
            Admin (<%= Issue.with_status(0).count  %>) <%= fa_icon 'wrench' %>
          <% end %>
        </li>
      <% elsif cuser.moderator? %>
        <li>
          <%= link_to issues_path, class: 'admin' do %>
            Issues (<%= Issue.where(category_id: Issue.allowed_categories(cuser)).with_status(0).count %>) <%= fa_icon 'wrench' %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to user_path(cuser) do %>
          Account <%= fa_icon 'user' %>
        <% end %>
      </li>
      <li>
        <%= link_to agenda_user_path(cuser) do %>
          Agenda <%= fa_icon 'calendar' %>
        <% end %>
      </li>
      <li>
        <%= link_to messages_path do %>
          Messages <%= fa_icon 'envelope' %>
        <% end %>
        <% if c = cuser.new_messages.count > 0 %>
          (<%= cuser.new_messages.count %>)
        <% end %>
      </li>
      <li>
        <%= link_to '#', data: { submit_form: true, form_id: 'logout-form' } do %>
          Logout <%= fa_icon 'key' %>
        <% end %>
        <%= form_tag(logout_sessions_path, id: 'logout-form', style: 'display:none;', data: { turbo: false }) do %>
        <% end %>
      </li>
    </ul>
  </div>

  <% if cuser.profile %>
    <div class="avatar" style="background-image: url('<%= cuser.profile.avatar.url %>')"></div>
  <% end %>
</div>
