<% otp_pending = session[:pending_login_otp].present? %>

<%= form_tag(login_users_path,
             { class: 'dark',
               data: {
                 controller: 'passkey-auth',
                 passkey_auth_options_url_value: passkey_options_users_path,
                 passkey_auth_authenticate_url_value: passkey_authenticate_users_path,
                 passkey_auth_disable_autofill_value: Rails.env.test?
               } }) do %>
  <div class="fields">
    <div class="header-icons">
      <%= link_to '#', class: 'steam-login', rel: 'noopener', data: { submit_form: true, form_id: 'steam-auth-form' } do %>
        <%= image_tag '/images/icons/steam_login.png' %>
      <% end %>
      <%= link_to ENV['DISCORD_URL'], target: '_blank', rel: 'noopener noreferrer' do %>
        <%= image_tag 'shared/discord.png', class: 'discord', alt: 'Go to ENSL Discord!' %>
      <% end %>
    </div>

    <%= text_field "login", "username", placeholder: "Username", autocomplete: "username webauthn" %>
    <%= password_field "login", "password", placeholder: "Password", autocomplete: "current-password" %>
    <% if otp_pending %>
      <%= text_field "login_otp", "code",
                     placeholder: t('sessions.form.otp_code'),
                     autocomplete: 'one-time-code',
                     inputmode: 'numeric' %>
    <% end %>
    <div class="passkey-status" data-passkey-auth-target="status"></div>
  </div>
  <div class="buttons">
    <div class="login">
      <% if otp_pending %>
        <%= submit_tag t('sessions.form.verify_otp'), class: 'login-action' %>
      <% else %>
        <%= submit_tag t('helpers.submit.user.login'), class: 'login-action' %>
        <%= link_to t('sessions.form.login_with_passkey'), '#',
                    class: 'passkey-link login-action',
                    data: { action: 'click->passkey-auth#login', passkey_auth_target: 'loginButton' } %>
      <% end %>
    </div>
    <div class="register">
      <%= link_to t('helpers.submit.user.create'), new_user_path %>
      <%= link_to t('sessions.form.forgot_password'), forgot_users_path, class: "password-reset" %>
    </div>
  </div>
<% end %>

<%= form_tag "/auth/steam", method: :post, id: 'steam-auth-form', style: 'display:none;' do %>
<% end %>
