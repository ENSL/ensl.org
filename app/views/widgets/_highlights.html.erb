<div class="widget highlights">
  <h4><%= t('widget.highlights') %></h4>

  <div class="widget-content-wrapper">
    <% active_contests = cuser&.active_contests %>
    <% recent_matches = Match.realfinished.reverse_order.recent.chrono %>
    <% future_matches = Match.future5.chrono %>

    <% if active_contests&.any? then %>
      <div class="separator">
        Your Matches
        <%= link_to "More", controller: :matches, matches: 'your' %>
      </div>
      <ol>
        <% active_contests.each do |contest| %>
          <li>
            <%= namelink contest %>
            <br />
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if Match.recent.count != 0 then %>
      <div class="separator">
        Latest Matches
        <%= link_to 'More', controller: :matches, matches: 'recent' %>
      </div>
      <ol>
        <% recent_matches.each do |match| %>
          <% contester1 = match.contester1 %>
          <% contester2 = match.contester2 %>
          <% team1 = contester1.team %>
          <% team2 = contester2.team %>
          <% contest = match.contest %>
          <li>
            <%= link_to match, :class => "bold #{match.score_color}" do %>
              <%= h match.score1 %> - <%= h match.score2 %>
              <%= link_to team1.tag, controller: :contesters, action: :show, id: contester1 %> <%= if match.score1 > match.score2 then ">>" elsif match.score2 > match.score1 then "<<" else "==" end %> <%= link_to team2.tag, controller: :contesters, action: :show, id: contester2 %>
                (<%= link_to contest.short_name, :controller => :contests, :action => :show, :id => contest.id %>)
            <% end %>
            <br />
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if future_matches.any? then %>
      <div class="separator">
        Upcoming matches
        <%= link_to 'More', controller: :matches, matches: 'upcoming' %>
      </div>
      <ol>
        <% future_matches.each do |match| %>
          <% contest = match.contest %>
          <li>
            <%= namelink match, 50 %><br>
            [<%= link_to contest.short_name, controller: :contests, action: :show, id: contest.id %>]
            <%= shorttime match.match_time %><br>
            <em><%= match.predictions.count %> preds : <%= match.preds(1) %>% - <%= match.preds(2) %>%</em>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
</div>