<div id="comment_<%= comment.id %>" class="comment">
  <% user = comment.user %>
  <% profile = user.profile %>
  <div class="comment-image">
    <%= image_tag profile.avatar.url %>
  </div>
  <div class="comment-content">
    <h1>
      <%= flag(user.country) if user.country %>
      <%= namelink(user) %>
      <% if user.team %> | <%= namelink(user.team) %><% end %>
    </h1>
    <div class="controls">
      <% if cuser %>
        <%= link_to '#', data:{on: :click, call: 'QuoteText',args: "#{comment.id}, 'comments'"} %>
        <% if comment.can_update? cuser %>
          <%= link_to fa_icon('pencil'), edit_comment_path(comment) %>
        <% end %>
        <% if comment.can_destroy? cuser %>
          <%= link_to fa_icon('times'), comment, :confirm => 'Are you sure?', :method => :delete %>
        <% end %>
      <% end %>
    </div>
    <div class="comment-body">
      <%= sanitize(comment.text_parsed) %>
    </div>
    <p class="comment-detail"><%= comment.created_at.strftime("%-d %B %Y, %H:%M") %></p>
  </div>
</div>
