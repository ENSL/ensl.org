<h1>Editing File</h1>

<%= form_for(@file, html: { class: 'square' }) do |f| %>
  <div id="<%= dom_id(@file) %>_errors_wrapper">
    <%= render 'shared/errors', messages: @file.errors.full_messages, container_id: "#{dom_id(@file)}_errors" %>
  </div>

  <%= cascade @file, ["name", "size_s", "md5_s"] %>

  <div class="fields horizontal">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div class="fields horizontal">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <div class="fields horizontal">
    <%= f.label :directory_id %>
    <%= f.select :directory_id, Directory.path_sorted.collect { |c| ["#{c.full_title} (#{c.relative_path})", c.id] } %>
  </div>

  <div class="controls">
    <%= f.submit 'Update' %>
  </div>
<% end %>

<h3>Related Files</h3>

<table class="striped">
  <tr>
    <th>Name</th>
    <th>Size</th>
    <th>Action</th>
  </tr>
  <% @file.related_files.each do |related| %>
    <tr>
      <td>
        <%= namelink related %>
      </td>
      <td>
        <%= related.size_s %> MB
      </td>
      <td>
        <%= link_to fa_icon('times'), data_file_path(related, data_file: { related_id: nil }, return_to: edit_data_file_path(@file)), method: :patch,
          title: 'Remove related file' %>
      </td>
    </tr>
  <% end %>
</table>

<%= form_tag data_file_path(@file), method: :patch,
  onsubmit: "var id=document.getElementById('add_related_candidate_id').value; if(!id){return false;} this.action='#{data_files_path}/'+id;" do %>
  <div class="fields">
    <%= select_tag :add_related_candidate_id, options_for_select(@add_related_options), include_blank: true %>
    <%= hidden_field_tag 'data_file[related_id]', @file.id %>
    <%= hidden_field_tag :return_to, edit_data_file_path(@file) %>
  </div>
  <div class="controls">
    <%= submit_tag 'Add' %>
  </div>
<% end %>
