<h1>Editing File</h1>

<%= form_for(@file, html: { class: 'square' }) do |f| %>
  <div id="<%= dom_id(@file) %>_errors_wrapper">
    <%= render 'shared/errors', messages: @file.errors.full_messages, container_id: "#{dom_id(@file)}_errors" %>
  </div>

  <%= cascade @file, ["name", "size_s", "md5_s"] %>

  <div class="fields horizontal">
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div class="fields horizontal">
    <%= f.label :description %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <div class="fields horizontal">
    <%= f.label :directory_id %>
    <%= f.select :directory_id, Directory.path_sorted.collect { |c| ["#{c.full_title} (#{c.relative_path})", c.id] } %>
  </div>

  <div class="controls">
    <%= f.submit 'Update' %>
  </div>
<% end %>

<h3>Related Files</h3>

<table class="striped">
  <tr>
    <th>Name</th>
    <th>Size</th>
    <th>Action</th>
  </tr>
  <% @file.related_files.each do |related| %>
    <tr>
      <td>
        <%= namelink related %>
      </td>
      <td>
        <%= related.size_s %> MB
      </td>
      <td>
        <%= link_to "Remove", delFile_data_file_path(@file, related_id: related.id), method: :delete %>
      </td>
    </tr>
  <% end %>
</table>

<%= form_for @file, url: { action: "addFile", id: @file }, method: :post do |f| %>
  <div class="fields">
    <%= f.select :related_id, @related_file_options %>
  </div>
  <div class="controls">
    <%= f.submit "Add" %>
  </div>
<% end %>
