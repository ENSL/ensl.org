<div id="post_<%= post.id %>" class="post">
  <% user = post.user %>
  <% profile = user.profile %>
  <div class="avatar" rowspan="2">
    <h5>
      <%= link_to user, user, class: ("admin" if user.admin?) %>
    </h5>

    <div class="image">
      <%= image_tag profile.avatar.url %>
    </div>

    <% if user.team %>
      <strong><%= namelink user.team %></strong>
    <% end %>

    <dl>
      <% if (entry = post_primary_group_entry(user)) %>
        <% group, task = entry %>
        <dt><%= namelink group %></dt>
        <dd><%= task %></dd>
      <% end %>
      <dt>Posts</dt>
      <dd><%= user.posts.count %></dd>
      <dt>Location</dt>
      <dd><%= user.from %></dd>
      <dt>Joined</dt>
      <dd><%= longdate user.created_at %></dd>
    </dl>
  </div>

  <div class="content">
    <div class="header">
      <div class="time">
        <span id="post_time_<%= post.id %>">
          <%= longertime post.created_at %>
        </span>
      </div>
      <div class="posts">
        <%= link_to "##{post.number(posts, n)}", "#post_#{post.id}" %>
      </div>
    </div>

    <div class="text">
      <%= sanitize(post.text_parsed) %>
    </div>
  </div>

  <div class="controls">
     <% if post.topic.posts.build.can_create? cuser %>
       <%= link_to 'Quote', '#', data:{on: :click, call: 'QuoteText', args: "#{post.id}"}, class: 'button tiny' %>
    <% end %>
    <% if post.can_update? cuser %>
      <%= link_to 'Edit', edit_post_path(post), class: 'button tiny' %>
    <% end %>
    <% if post.can_destroy? cuser %>
      <%= link_to 'Delete', post, method: :delete, data: { confirm: 'Are you sure?', turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'button tiny' %>
    <% end %>
  </div>

  <div class="base">
    <div class="user">
      <% if cuser && user.present? && user != cuser %>
        <% begin %>
          <% if Message.new.can_create?(cuser) %>
            <%= link_to "Send PM", new_message_path(id: 'User', id2: user.id), class: 'button tiny' %>
          <% end %>
        <% rescue => e %>
          <!-- Send PM not available -->
        <% end %>
      <% end %>
    </div>

    <div class="signature">
      <%= sanitize(profile.signature_parsed) if profile.signature_parsed %>
    </div>
  </div>
</div>
