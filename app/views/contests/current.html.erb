<h1 class="title">Current Contests</h1>

<% @contests.each do |contest| %>
  <h3><%= link_to contest.name, contest %></h3>

  <% if contest.contest_type == Contest::TYPE_BRACKET %>
    <%= render "bracket", contest: contest %>
  <% elsif contest.contest_type == Contest::TYPE_LADDER %>
    <%= render "contesters/ladder", actions: true, contest: contest %>
  <% else %>
    <%= render "contesters/list", contesters: contest.contesters.active.ordered,
      actions: true, contest: contest, friendly: nil %>
  <% end %>
<% end %>
