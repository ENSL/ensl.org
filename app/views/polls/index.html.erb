<h1>Listing Polls</h1>

<table class="polls striped">
  <tr>
    <th class="question w-[30%]">Question</th>
    <th class="date w-[30%]">End date</th>
    <th class="votes w-[15%]">Votes</th>
    <th class="user w-[15%]">User</th>
    <% if cuser and cuser.admin? %>
      <th class="actions w-[10%] text-right"></th>
    <% end %>
  </tr>

  <% @polls.each do |poll| %>
    <tr>
      <td><%= link_to (h poll.question), poll %></td>
      <td><%= longtime poll.end_date %></td>
      <td><%=h poll.votes %></td>
      <td><%=h poll.user %></td>
      <% if cuser and cuser.admin? %>
        <td class="actions w-[10%] text-right">
          <%= link_to fa_icon('pencil'), edit_poll_path(poll) %>
          <a href="#" onclick="if(!confirm('Are you sure?')) return false;" data-submit-form="true" data-form-id="delete_poll_<%= poll.id %>"><%= fa_icon('times') %></a>
          <%= form_tag poll_path(poll), method: :post, id: "delete_poll_#{poll.id}", style: 'display:none;' do %>
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :_method, 'delete' %>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
</table>

<% if cuser and cuser.admin? %>
  <%= link_to 'New Poll', new_poll_path, class: 'button' %>
<% end %>
