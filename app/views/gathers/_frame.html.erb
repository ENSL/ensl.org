<% gather = local_assigns.fetch(:gather) %>
<% gatherer = local_assigns[:gatherer] %>

<%= turbo_frame_tag dom_id(gather, :frame), data: { src: gather_path(gather) } do %>
  <div id="gather_<%= gather.id %>_version" data-version="<%= gather.version %>"></div>

  <div id="gather-area">
    <%= render_gather(gather, gatherer) %>
  </div>
<% end %>
