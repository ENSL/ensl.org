<div id="gather" data-controller="gather-sync"
                 data-gather-sync-gather-id-value="<%= @gather.id %>"
                 data-gather-sync-version-value="<%= @gather.version %>"
                 data-gather-sync-poll-interval-value="<%= Rails.env.test? ? 5000 : 8000 %>"
                 data-gather-sync-dead-reload-after-value="<%= Rails.env.test? ? 10000 : 600000 %>">
  <% if cuser %>
    <%= turbo_stream_from [@gather, cuser] %>
  <% else %>
    <%= turbo_stream_from @gather %>
  <% end %>
  <h1 class="fancy">
    <span>
      <%= link_to @gather do %>
        <%= @gather.category.to_s %> Gather
      <% end %>
    </span>
  </h1>

  <div class="previous">
    <%= link_to @gather.previous_gather, class: 'button tiny' do %>
      <%= fa_icon 'chevron-left' %> Previous
    <% end %>
  </div>

  <div class="next">
    <% if @gather.next_gather %>
      <%= link_to @gather.next_gather, class: 'button tiny' do %>
        Next <%= fa_icon 'chevron-right' %>
      <% end %>
    <% end %>
  </div>

  <% if @gather and @gather.status != Gather::STATE_FINISHED %>
    <div id="gather-info">
      <div class="info">
        <h6>Follow these steps to play</h6>
        <ol>
          <li><%= link_to "Instructions", article_path(1086) %></li>
          <li><%= link_to "Join the discord", ENV['DISCORD_NS1_URL'] %></li>
          <li><%= link_to "Connect to game server", "steam://connect/51.15.77.137:27015/europe// -noforcemparms" %></li>
        </ol>
      </div>
      <div class="info">
        <h6>Requirements</h6>
        <ul>
          <li><a href="https://www.google.com/adsense/support/bin/answer.py?hl=en&amp;answer=12654">JavaScript</a> enabled</li>
          <li>Read the <%= link_to "Gather Rules", article_url(Article::G_RULES) %></li>
          <li>Remove yourself if you leave</li>
        </ul>
      </div>
      <div class="info">
        <h6>Captains</h6>
        <ul>
          <li>Vote for the <strong>best</strong> players</li>
          <li>Captain 1 = 2nd most voted</li>
          <li>Captain 2 = 1st most voted</li>
        </ul>
      </div>
      <div class="info">
        <h6>Voice Communication</h6>
        <ul>
          <li><%= link_to "Discord", "https://www.discord.com" %></li>
          <li><strong>Click to join:</strong> <a href="<%= ENV['DISCORD_NS1_URL'] %>">NS1 Discord</a></li>
        </ul>
      </div>

      <div class="hide">
        <a id="gather-info-hide" class="button tiny">
          <%= fa_icon 'times' %>
          Hide information
        </a>
      </div>
    </div>
  <% end %>

  <%= render partial: 'gathers/frame', locals: { gather: @gather, gatherer: @gatherer } %>

</div>

<%= render partial: 'shoutmsgs/index', locals: { object: @gather } %>
