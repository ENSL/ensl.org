<%
  progress_title = 'Progress'
  progress_icon = 'users'
  progress_current = 0
  progress_total = Gather::FULL
  progress_value_text = ''

  case gather.status
  when Gather::STATE_RUNNING
    progress_title = 'Signed Up'
    progress_current = gather.gatherers.count
    progress_total = Gather::FULL
    progress_value_text = "#{progress_current}/#{progress_total}"
  when Gather::STATE_VOTING
    progress_title = 'Voting Time Left'
    progress_icon = 'clock-o'
    progress_total = gather.voting_timeout
    progress_current = gather.voting_time_remaining
    progress_value_text = "#{progress_current}s"
  when Gather::STATE_PICKING
    progress_title = 'Players Picked'
    progress_icon = 'users'
    players_left = gather.gatherers.lobby.count
    progress_total = Gather::FULL
    progress_current = progress_total - players_left
    progress_value_text = "#{players_left} left"
  when Gather::STATE_FINISHED
    progress_title = 'Teams Ready'
    progress_icon = 'check'
    progress_current = Gather::FULL
    progress_total = Gather::FULL
    progress_value_text = 'Complete'
  end

  progress_total = 1 if progress_total.to_i <= 0
  progress_current = [[progress_current.to_i, 0].max, progress_total.to_i].min
  progress_percent = ((progress_current.to_f / progress_total.to_f) * 100).round
  voting_progress_id = "gather-progress-voting-#{gather.id}"
%>

<div class="gather-progress mt-3 mb-4"
     <% if gather.status == Gather::STATE_VOTING %>
       id="<%= voting_progress_id %>"
       data-remaining="<%= progress_current %>"
       data-total="<%= progress_total %>"
     <% end %>>
  <div class="flex items-center justify-between text-sm mb-1">
    <span>
      <%= fa_icon progress_icon %>
      <strong><%= progress_title %></strong>
    </span>
    <span class="gather-progress-value"><%= progress_value_text %></span>
  </div>

  <div class="h-2 w-full rounded overflow-hidden bg-white/20">
    <div class="gather-progress-fill h-full bg-sky-500" style="width: <%= progress_percent %>%;"></div>
  </div>
</div>

<% if gather.status == Gather::STATE_VOTING %>
  <script>
    (function() {
      const progressEl = document.getElementById('<%= voting_progress_id %>');
      if (!progressEl) return;

      const fillEl = progressEl.querySelector('.gather-progress-fill');
      const valueEl = progressEl.querySelector('.gather-progress-value');
      const total = parseInt(progressEl.dataset.total, 10);
      let remaining = parseInt(progressEl.dataset.remaining, 10);

      if (!fillEl || !valueEl || Number.isNaN(total) || Number.isNaN(remaining) || total <= 0) return;

      const interval = setInterval(function() {
        remaining = Math.max(remaining - 1, 0);
        valueEl.textContent = remaining + 's';
        fillEl.style.width = ((remaining / total) * 100).toFixed(0) + '%';

        if (remaining <= 0) {
          clearInterval(interval);
        }
      }, 1000);
    })();
  </script>
<% end %>