<div id="gather-stats">
  <% if @gatherer && @gatherer.created_at && @gatherer.created_at > 10.seconds.ago %>
    <div class="message notice"><%= t(:gathers_join) %></div>
  <% end %>

  <% if @gather.status == Gather::STATE_RUNNING %>

    <% if @gatherer and @gatherer.can_destroy? gather_current_user %>
      <p>Gather running, <%= Gather::FULL - @gather.gatherers.length %> more needed.</p>
      <%= button_to 'Leave Gather', @gatherer, method: :delete, authenticity_token: false, form: { data: { turbo: false }, class: 'inline' }, class: 'button', data: { confirm: 'Are you sure?' } %>

    <% elsif (g = Gatherer.new(gather: @gather, user: gather_current_user)).can_create?(gather_current_user) %>
      <%= form_for g, url: gatherers_path, authenticity_token: false, html: { id: "new_gatherer_#{@gather.id}", data: { turbo_stream: true } } do |f| %>
        <%= f.hidden_field :gather_id, value: @gather.id %>
        <%= f.hidden_field :user_id, value: gather_current_user.id %>

        <p>Gather running, <%= Gather::FULL - @gather.gatherers.length %> more needed.</p>
        <p>
          You can download custom maps via the
          <%= link_to "Steam Workshop", "http://steamcommunity.com/workshop/browse?searchtext=&childpublishedfileid=0&section=items&appid=4920&browsesort=trend&requiredtags%5B%5D=level" %>.
        </p>

        <p>
          <% if gather_current_user.gatherers.count < 5 %>
            <%= f.check_box :confirm %> I have read the <%= link_to "rules", article_url(Article::G_RULES) %>, installed NS and Discord.
          <% end  %>
        </p>
        <p>
          <%= f.submit 'Click to join gather!', class: 'button' %>
          <%= link_to gathers_path(), class: 'button' do %>
            Gather archive
          <% end %>
        </p>
      <% end %>

    <% else %>
      <p>Log in to join the gather.</p>
      <%= link_to gathers_path(), class: 'button tiny' do %>
        Gather archive
      <% end %>
    <% end %>

  <% elsif @gather.status == Gather::STATE_VOTING %>
    <p>
      Please vote captains and maps.
      <% if (remaining = @gather.voting_time_remaining) > 0 %>
        <span id="voting-timer" data-remaining="<%= remaining %>">
          (<span class="time-left"><%= remaining %></span>s remaining)
        </span>
      <% end %>
    </p>
    <script>
      (function() {
        const timerEl = document.getElementById('voting-timer');
        if (!timerEl) return;
        
        let remaining = parseInt(timerEl.dataset.remaining);
        const timeLeftEl = timerEl.querySelector('.time-left');
        
        const interval = setInterval(function() {
          remaining--;
          if (remaining <= 0) {
            clearInterval(interval);
            timeLeftEl.textContent = '0';
          } else {
            timeLeftEl.textContent = remaining;
          }
        }, 1000);
      })();
    </script>

  <% elsif @gather.status == Gather::STATE_PICKING %>
    <p>
      <% if @gatherer and @gatherer.captain? %>
        <% if @gatherer.turn? %>
          It is your turn, please pick a player from the lobby!
        <% else%>
          Wait for the other captain to pick.
        <% end %>
      <% else %>
        Captains are picking the teams, please wait. Are you a panda?<br>
      <% end %>
    </p>

  <% elsif @gather.status == Gather::STATE_FINISHED and @gather.server %>
    <p>Gather finished, join the Server and voice communication.</p>

    <p>
      <strong>Maps</strong>: <%= namelink @gather.map1.map if @gather.map1 %>, <%= (namelink @gather.map2.map) if @gather.map2 %> <br>
      <strong>Server</strong>:
      <% if @gather.server %>
        <%= @gather.server %>
        (<%= @gather.server.ip %>:<%= @gather.server.port %> ;
        password = <%= if @gather.server.password then @gather.server.password else "<Password not specified>" end %>)
      <% end %>
    </p>

    <p>
    <% if @gather.server and @gather.server.ip and @gather.server.password %>
      <%= link_to "Click to join Server", "steam://run/4920//connect #{@gather.server.ip} #{@gather.server.password}", class: 'join button tiny' %>
    <% end %>
    <%= link_to gathers_path(), class: 'button tiny' do %>
      Gather archive
    <% end %>
    </p>
  <% end %>
  <div class="gather-controls"
       data-controller="gather-music"
       data-gather-music-should-play-value="<%= gather_music_should_play? %>">
    <%= audio_tag '/sounds/gather-1.mp3', id: 'gather-music', class: 'gather-audio', loop: true, preload: 'metadata', data: { gather_music_target: 'audio' } %>
    <%= button_tag 'Mute', type: 'button', id: 'mute', class: 'button', data: { gather_music_target: 'muteButton', action: 'gather-music#toggleMute' } %>
    <% if gather_current_user and (gather_current_user.admin? or gather_current_user.gather_moderator?) %>
      <%= link_to "Admin Page", edit_gather_path(@gather), class: 'admin button', data: { turbo: false } %>
    <% end %>
  </div>
</div>
