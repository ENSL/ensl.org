<div class="gather-columns">
  <div class="data">
    <div class="contents">
      <% gather = @gather %>
      <% current_gatherer = @gatherer %>
      <% gatherers = gather.gatherers.most_voted %>
      <h4>Vote Captains</h4>
      <%= render partial: 'gathers/progress' %>

      <table id="gatherers">
        <% gatherers.each do |gatherer| %>
          <% user = gatherer.user %>
          <tr>
            <td><%= flag user.country %></td>
            <td>
              (<%= gatherer.votes %>)
              <% vote = gatherer.real_votes.build(user: gather_current_user) %>
              <% if current_gatherer and vote.can_create? gather_current_user %>
                <%= link_to user, votes_path(vote: { votable_id: gatherer.id, votable_type: "Gatherer" }), class: 'vote-link', data: { submit_form: true, form_id: 'vote_form', url: votes_path(vote: { votable_id: gatherer.id, votable_type: "Gatherer" }), turbo: false } %>
              <% else %>
                <%= link_to user.to_s, user, class: 'user', data: { turbo_frame: '_top' } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>

      <% if current_gatherer %>
        <p>Click to vote for captain.</p>
      <% end %>
    </div>
  </div>

  <%= render partial: 'gathers/votes' %>
</div>

<%= render partial: 'gathers/status', locals: { gather: @gather, gatherer: @gatherer } %>
