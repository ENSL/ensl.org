<div class="gather-columns">
  <div class="data">
    <div class="contents">
      <h4>Vote Captains</h4>
      <%= render partial: 'gathers/progress' %>

      <table id="gatherers">
        <% @gather.gatherers.most_voted.each do |gatherer| %>
          <tr>
            <td><%= flag gatherer.user.country %></td>
            <td>
              (<%= gatherer.votes %>)
              <% if @gatherer and gatherer.real_votes.build(user: gather_current_user).can_create? gather_current_user %>
                <%= link_to gatherer.user, votes_path(vote: { votable_id: gatherer.id, votable_type: "Gatherer" }), class: 'vote-link', data: { submit_form: true, form_id: 'vote_form', url: votes_path(vote: { votable_id: gatherer.id, votable_type: "Gatherer" }), turbo: false } %>
              <% else %>
                <%= namelink gatherer.user %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>

      <% if @gatherer %>
        <p>Click to vote for captain.</p>
      <% end %>
    </div>
  </div>

  <%= render partial: 'gathers/votes' %>
</div>

<%= render partial: 'gathers/status' %>
