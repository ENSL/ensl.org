<% vote_maps, vote_servers = false %>

<div class="data servers">
  <div class="contents">
    <h4>Server Votes</h4>

    <% active_gather_servers = @gather.gather_servers.joins(:server).merge(Server.active).includes(:server).ordered %>

    <ul class="votes" id="server-votes">
      <% active_gather_servers.each do |server| %>
        <li>
          <span class="count">
            <%= if server.votes then server.votes else "0" end %>
          </span>
          <% real_server = server.server %>
          <% if server.real_votes.build(user: gather_current_user).can_create? gather_current_user %>
            <%= link_to votes_path(vote: { votable_id: server.id, votable_type: "GatherServer" }), class: 'vote-link', data: { submit_form: true, form_id: 'vote_form', url: votes_path(vote: { votable_id: server.id, votable_type: "GatherServer" }), turbo: false } do %>
              <%= fa_icon('server', class: real_server.online? ? 'text-green-600' : 'text-red-600') %>
              <strong><%= h real_server.name %></strong><br>
            <% end %>
            <% vote_servers = true else %>
            <%= fa_icon('server', class: real_server.online? ? 'text-green-600' : 'text-red-600') %>
            <strong><%= h real_server.name %></strong><br>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if vote_servers %>
      <p>Click to vote!</p>
    <% end %>
  </div>
</div>

<%= form_tag '', method: :post, id: 'vote_form', data: { turbo: false }, style: 'display:none;' do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
<% end %>

<div class="data">
  <div class="contents">
    <h4>Map Votes</h4>

    <ul class="votes" id="map-votes">
      <% @gather.gather_maps.ordered.each do |map| %>
        <li>
          <span><%= map.votes %></span>
          <% if map.real_votes.build(user: gather_current_user).can_create? gather_current_user %>
            <%= link_to shorten(map, 30), votes_path(vote: { votable_id: map.id, votable_type: "GatherMap" }), class: 'vote-link', data: { submit_form: true, form_id: 'vote_form', url: votes_path(vote: { votable_id: map.id, votable_type: "GatherMap" }), turbo: false } %>
            <% vote_maps = true %>
          <% else %>
            <%= shorten map, 30 %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if vote_maps %>
      <p>Click to vote</p>
    <% end %>
  </div>
</div>
