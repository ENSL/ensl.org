<div class="gather-columns">
  <div class="data players">
    <div class="contents">
      <h4>Signed Up</h4>


      <ul id="gatherers">
        <% @gather.gatherers.each do |gatherer| %>
          <li<% if gatherer.status > 0 %> class="away"<% end %>>
            <%= flag gatherer.user.country %>
            <%= namelink gatherer.user %>
            ( <%= gatherer.user.idle %> )
            <% if cuser and gatherer.can_destroy?(cuser) %>
              <%= form_tag gatherer, method: :post, id: "delete_gatherer_#{gatherer.id}", data: { turbo: false }, style: 'display:inline;margin:0;' do %>
                <%= hidden_field_tag :_method, 'delete' %>
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <%= link_to '#', class: 'delete delete-gatherer', data: { submit_form: true, form_id: "delete_gatherer_#{gatherer.id}" } do %>
                  <%= icon 'times' %>
                <% end %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>  
    </div>
  </div>

  <%= render partial: 'gathers/votes' %>
</div>

<%= render partial: 'gathers/status' %>
  