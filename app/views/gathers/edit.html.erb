<h1>Gather Admin: #<%= @gather.id %></h1>

<% unless @gather.status == Gather::STATE_RUNNING %>
<div class="restart">
    <h3>Restart Gather</h3>

    <%= form_for(@gather, html: { class: 'square' }) do |f| %>
    <%= render 'shared/errors', messages: @gather.errors.full_messages %>

    <div class="fields horizontal">
        <%= f.label :captain1 %>
        <%= f.select :captain1_id, @gather.gatherers.collect{|c| [c, c.id]} %>
    </div>
    <div class="fields horizontal">
        <%= f.label :captain2 %>
        <%= f.select :captain2_id, @gather.gatherers.collect{|c| [c, c.id]} %>
    </div>

    <div class="controls">
        <%= f.submit 'Restart Gather' %>
    </div>
    <% end %>
</div>

<div class="turns">
    <h3>Change Turns</h3>

    <%= form_for(@gather, html: { class: 'square' }) do |f| %>
    <%= render 'shared/errors', messages: @gather.errors.full_messages %>

    <div class="fields horizontal">
        <%= f.label :turn %>
        <%= f.select :turn, [['Team 1', 1], ['Team 2', 2]] %>
    </div>
    <div class="controls">
        <%= f.submit 'Change Turn' %>
    </div>
    <% end %>
</div>

<% if [Gather::STATE_PICKING, Gather::STATE_FINISHED].include?(@gather.status) %>
<div class="maps-server">
    <h3>Change Maps and Server</h3>

    <%= form_for(@gather, html: { class: 'square' }) do |f| %>
    <%= render 'shared/errors', messages: @gather.errors.full_messages %>

    <div class="fields horizontal">
        <%= f.label :map1_id, "Map #1" %>
        <%= f.select :map1_id, @gather.gather_maps.collect { |gather_map| [gather_map.map, gather_map.id] } %>
    </div>
    <div class="fields horizontal">
        <%= f.label :map2_id, "Map #2" %>
        <%= f.select :map2_id, @gather.gather_maps.collect { |gather_map| [gather_map.map, gather_map.id] } %>
    </div>
    <div class="fields horizontal">
        <%= f.label :server_id, "Server" %>
        <%= f.select :server_id, @gather.servers.collect { |server| [server, server.id] } %>
    </div>
    <div class="controls">
        <%= f.submit 'Change Maps and Server' %>
    </div>
    <% end %>
</div>
<% end %>


<div class="replace">
    <h3>Replace Players</h3>

    <% if @gather.gatherers.first %>
    <%= form_for(@gather.gatherers.first, html: { class: 'square' }) do |f| %>
    <div class="fields horizontal">
        <%= f.label :id, "Select Player" %>
        <%= f.select :id, @gather.gatherers.collect{|g| [g.user, g.id]} %>
    </div>
    <div class="fields horizontal">
        <%= f.label :username, "Replace with:" %>
        <%= render 'shared/user_search_field', form: f, attribute: :username,
                                               list_id: 'replacement_usernames' %>
    </div>
    <div class="controls">
        <%= f.submit 'Replace Player' %>
    </div>
    <% end %>
    <% end %>
</div>
<% end %>

<% if @gather.open_for_join? %>
<div class="add-player">
    <h3>Add Player</h3>

    <%= form_for Gatherer.new(gather: @gather), html: { class: 'square' } do |f| %>
    <%= f.hidden_field :gather_id %>
    <%= f.hidden_field :confirm, value: '1' %>

    <div class="fields horizontal">
        <%= f.label :username, "Username" %>
        <%= render 'shared/user_search_field', form: f, attribute: :username,
                                               list_id: 'additional_player_usernames' %>
    </div>
    <div class="controls">
        <%= f.submit 'Add Player' %>
    </div>
    <% end %>
</div>
<% end %>

<div class="restart">
    <h3>Start New</h3>
    <%= form_for Gather.new do |f| %>
    <% f.object.category = @gather.category %>
    <%= f.hidden_field :category_id %>

    <div class="controls">
        <%= f.submit "Start New Gather (#{f.object.category})" %>
    </div>
    <% end %>
</div>