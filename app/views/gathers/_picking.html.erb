<nav class="gather-mobile-nav">
  <a href="#picking-lobby" data-turbo="false">Lobby</a>
  <a href="#picking-marines" data-turbo="false">Marines</a>
  <a href="#picking-aliens" data-turbo="false">Aliens</a>
</nav>

<div class="gather-columns">
  <div class="data players" id="picking-lobby">
    <div class="contents">
      <h4>
        Lobby
      </h4>
      <%= render partial: 'gathers/progress', locals: { gather: gather } %>
      <%= render partial: "gatherers/list", locals: { team: nil, gather: gather, gatherer: gatherer } %>
    </div>
  </div>

  <div class="data players" id="picking-marines">
    <div class="contents">
      <h4>
        Marines
      </h4>
      <%= render partial: "gatherers/list", locals: { team: 1, gather: gather, gatherer: gatherer } %>
    </div>
  </div>

  <div class="data players" id="picking-aliens">
    <div class="contents">
      <h4>
        Aliens
      </h4>
      <%= render partial: "gatherers/list", locals: { team: 2, gather: gather, gatherer: gatherer } %>
    </div>
  </div>
</div>

<%= render partial: "gathers/status", locals: { gather: gather, gatherer: gatherer } %>

