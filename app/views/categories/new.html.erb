<h1>New Category</h1>

<%= form_for(@category, html: { class: 'square' }) do |f| %>
  <div id="<%= error_wrapper_id_for(@category) %>">
    <%= render 'shared/errors', messages: @category.errors.full_messages, container_id: error_container_id_for(@category) %>
  </div>

  <div class="fields horizontal">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="fields horizontal">
    <%= f.label :domain %>
    <%= f.select :domain, @category.domains.invert %>
  </div>

  <div class="controls">
    <%= f.submit 'Create Category' %>
  </div>
<% end %>
