<table class="contest striped">
  <thead>
    <tr>
      <th class="movement w-[5%]"></th>
      <th class="flag w-[5%]"></th>
      <th class="team w-[35%]">Team</th>
      <th class="awards w-[5%]"></th>
      <th class="score w-[10%]">Score</th>
      <th class="win w-[10%]">Win</th>
      <th class="loss w-[10%]">Loss</th>
      <th class="draw w-[10%]">Draw</th>
      <% if actions %>
        <th class="actions w-[10%]"></th>
      <% end %>
    </tr>
  </thead>

  <tbody>
  <% contesters.each do |contester| %>
    <% team = contester.team %>
    <% contest = contester.contest %>
    <tr>
      <% if contester.trend == Contester::TREND_UP %>
        <td><%= fa_icon 'chevron-up' %></td>
      <% elsif contester.trend == Contester::TREND_DOWN %>
        <td><%= fa_icon 'chevron-down' %></td>
      <% elsif contester.trend == Contester::TREND_FLAT %>
        <td><%= fa_icon 'minus' %></td>
      <% else %>
        <td></td>
      <% end %>
      <td><%= flag team.country %></td>
      <td><%= link_to (h team.name), contester %></td>
      <td><%= fa_icon 'trophy' if contester == contest.winner %></td>
      <td><%= h contester.total_score %></td>
      <td><%= h contester.win %></td>
      <td><%= h contester.loss %></td>
      <td><%= h contester.draw %></td>
      <% if actions %>
        <td class="actions w-[10%] text-right">
          <% if friendly %>
            <% challenge = Challenge.new
            challenge.contester1 = friendly
            challenge.contester2 = contester %>
            <% if challenge.can_create? cuser %>
              <%= link_to 'C', controller: 'challenges', id: contester, action: 'new' %>
            <% end %>
          <% end %>
          <% if cuser and cuser.admin? %>
            <%= link_to fa_icon('pencil'), edit_contester_path(contester) %>
            <%= link_to fa_icon('times'), contester, confirm: 'Are you sure?', method: :delete %>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
