<!doctype html>
<html>
  <%= render partial: "head" %>
  <body data-disable-flash-fade="<%= Rails.env.test? %>">
    <div id="container">
      <%= render partial: "header" %>
      <%= render partial: "navigation" %>
      <div class="body wrapper">
        <div id="content" class="full">
          <%= render partial: "messages" %>
          <%= yield %>
        </div>
      </div>
      <%= render partial: "footer" %>
    </div>
  </body>
</html>
