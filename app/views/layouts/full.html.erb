<!doctype html>
<html>
  <%= render "head" %>
  <body data-disable-flash-fade="<%= Rails.env.test? %>" data-controller="twemoji emoji-autocomplete">
    <div id="container">
      <%= render "header" %>
      <%= render "navigation" %>
      <div class="relative z-10 mx-auto max-w-[1020px]">
        <div id="content" class="full">
          <%= render "messages" %>
          <%= yield %>
        </div>
      </div>
      <%= render "footer" %>
    </div>
  </body>
</html>
