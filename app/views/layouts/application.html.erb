<!doctype html>
<html>
  <%= render partial: "head" %>
  <body data-disable-flash-fade="<%= Rails.env.test? %>" data-controller="twemoji emoji-autocomplete">
    <div id="container">
      <%= render partial: "messages" %>
      <%= render partial: "header" %>
      <%= render partial: "navigation" %>
      <div class="body wrapper">
        <div id="content" class="<%= yield :main_class %>">
          <div id="main">
            <%= yield %>
          </div>
          <div id="sidebar">
            <%= yield :sidebar %>
            <% ['shoutbox', 'posts', 'poll'].each do |widget| %>
              <%= render partial: "widgets/#{widget}" %>
            <% end %>
          </div>
        </div>
      </div>
      <%= render partial: "footer" %>
    <% if Rails.env.test? %>
      <script type="text/javascript">
        (function(){
          function showTabs(){
            var tabs = document.querySelectorAll('.tab');
            for(var i=0;i<tabs.length;i++){ tabs[i].style.display = 'block'; }
          }
          if (document.readyState === 'complete' || document.readyState === 'interactive') showTabs();
          else document.addEventListener('DOMContentLoaded', showTabs);
        })();
      </script>
    <% end %>
    </div>
  </body>
</html>
