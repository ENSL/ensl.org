<!doctype html>
<html>
  <%= render "head" %>
  <body>
    <div id="container">
      <%= render "header" %>
      <%= render "navigation" %>
      <div class="relative z-10 mx-auto max-w-[1020px]">
        <div id="content" class="full <%= yield :content_class %>">
          <%= render "messages" %>
          <div id="forums">
            <%= yield %>
          </div>
        </div>
      </div>
      <%= render "footer" %>
    </div>
  </body>
</html>
