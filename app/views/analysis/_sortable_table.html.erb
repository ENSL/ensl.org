<table<%= %( id="#{id}").html_safe if id %> class="data sortable-table" data-controller="sortable-table">
  <thead>
    <tr>
      <% columns.each do |column| %>
        <% column_type = (column[:type] || :string).to_sym %>
        <% tooltip = column[:tooltip] %>
        <th
          class="<%= 'sortable-table-number' if column_type == :number %><%= ' sortable-table-tip' if tooltip %>"
          data-sort-type="<%= column_type %>"
          <% if tooltip %>data-tooltip="<%= tooltip %>" aria-label="<%= column[:label] %>: <%= tooltip %>"<% end %>
        >
          <span class="sortable-table-label"><%= column[:label] %></span>
        </th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% rows.each do |row| %>
      <tr>
        <% columns.each do |column| %>
          <% column_type = (column[:type] || :string).to_sym %>
          <% raw_value = row[column[:key]] %>
          <% sort_value = column[:sort_value] ? column[:sort_value].call(raw_value) : raw_value %>
          <td class="<%= 'sortable-table-number' if column_type == :number %>" data-sort-value="<%= sort_value %>">
            <%= column[:format] ? column[:format].call(raw_value) : raw_value %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
