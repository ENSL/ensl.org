<%= link_to 'Back', analysis_root_path, class: 'analysis-back' %>
<h1 class="title">NS1 Class performance</h1>

<div class="box wide">
  <p>
    Per-player class performance from the most recent analysis batch, aggregated across all maps and teams.
    All classes sums each player's reliable classes. Click a column header to sort.
  </p>

  <%= form_with url: analysis_classes_path, method: :get, local: true do %>
    <p class="analysis-filters">
      <span>
        <%= label_tag :class_name, 'Class:' %>
        <%= select_tag :class_name,
                       options_for_select([['All classes', '']] + @class_names.map { |name| [name.titleize, name] }, @selected_class_name),
                       onchange: 'this.form.requestSubmit()' %>
      </span>
      <span>
        <%= label_tag :min_games, 'Minimum games:' %>
        <%= select_tag :min_games,
                       options_for_select(@min_games_options.map { |count| [count, count] }, @selected_min_games),
                       onchange: 'this.form.requestSubmit()' %>
      </span>
    </p>
  <% end %>

  <% if @performances.empty? %>
    <p>No class performance data is available yet.</p>
  <% else %>
    <p class="text-sm text-gray-600">
      Based on <%= number_with_delimiter(@rounds_analysed) %> finished rounds; showing <%= number_with_delimiter(@performances.size) %> of <%= number_with_delimiter(@possible_users) %> player records.
    </p>
    <% format_number = lambda { |value, precision: 1| value.nil? ? '–' : number_with_precision(value, precision: precision) } %>

    <%= sortable_table(
      id: 'class-performance',
      columns: [
        { key: :user, label: 'Player', type: :string, sort_value: ->(user) { user.to_s.downcase }, format: ->(user) { namelink(user) } },
        { key: :sample_size, label: 'Games', type: :number, format: ->(value) { value&.to_i } },
        { key: :kills, label: 'Kills', type: :number, format: ->(value) { value&.to_i } },
        { key: :deaths, label: 'Deaths', type: :number, format: ->(value) { value&.to_i } },
        { key: :kill_death_ratio, label: 'K/D', type: :number, format: format_number },
        { key: :damage, label: 'Damage', type: :number, format: ->(value) { format_number.call(value, precision: 0) } },
        { key: :damage_per_minute, label: 'Damage/min', type: :number, format: format_number },
        { key: :damage_per_resource, label: 'Damage/resource', type: :number, format: format_number },
        { key: :win_rate, label: 'Win rate %', type: :number, sort_value: ->(value) { value && value * 100 }, format: ->(value) { value.nil? ? '–' : format_number.call(value * 100) } }
      ],
      rows: @performances
    ) %>
  <% end %>
</div>