<%= link_to 'Back', analysis_root_path, class: 'analysis-back' %>
<h1 class="title">NS1 <%= @tech_tree_team %> Graph</h1>

<div class="wide tech-tree">
  <p>Observed opening choices, joined where their order overlaps.</p>
  <p class="text-sm text-gray-600">
    Based on <%= number_with_delimiter(@rounds_analysed) %> rounds. Each icon is a <%= @tech_tree_step %> seen in at
    least <%= MarineTechPathQuery::DEFAULT_MIN_ROUNDS %> openings. Every qualifying continuation is shown. Each node
    shows the <%= @tech_tree_team.downcase %> win rate; hover an icon for its name.
  </p>

  <% if @tech_paths.empty? %>
    <p>No qualifying tech paths were found.</p>
  <% else %>
    <div
      data-controller="tech-tree"
      data-tech-tree-diagram-value="<%= tech_tree_diagram(@tech_paths) %>"
      data-tech-tree-icons-value="<%= tech_tree_icons(@tech_paths).to_json %>"
    >
      <div class="tech-tree__graph" data-tech-tree-target="graph"></div>
      <div class="tech-tree__tooltip" data-tech-tree-target="tooltip" hidden></div>
    </div>
  <% end %>
</div>