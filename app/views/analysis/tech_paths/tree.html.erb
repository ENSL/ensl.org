<%= link_to 'Back', analysis_root_path, class: 'analysis-back' %>
<h1 class="title">NS1 <%= @tech_tree_team %> Graph</h1>

<div class="wide tech-tree">
  <p>Observed opening choices, joined where their order overlaps. <%= @tech_tree_rules %></p>

  <%= form_with url: @tech_tree_team == 'Marine' ? analysis_tech_tree_path : analysis_alien_tech_tree_path, method: :get, local: true do %>
    <p class="analysis-filters">
      <span>
        <%= label_tag :min_rounds, 'Minimum rounds:' %>
        <%= select_tag :min_rounds,
                       options_for_select(@min_rounds_options.map { |count| [count, count] }, @selected_min_rounds),
                       onchange: 'this.form.requestSubmit()' %>
      </span>
    </p>
  <% end %>

  <p class="text-sm text-gray-600">
    Based on <%= number_with_delimiter(@rounds_analysed) %> finished rounds; showing <%= number_with_delimiter(@tech_paths.size) %> of <%= number_with_delimiter(@paths_found) %> opening <%= @tech_tree_team == 'Marine' ? 'research' : 'chamber' %> paths.
  </p>

  <% if @tech_paths.empty? %>
    <p>No qualifying tech paths were found.</p>
  <% else %>
    <div
      data-controller="tech-tree"
      data-tech-tree-diagram-value="<%= tech_tree_diagram(@tech_paths) %>"
      data-tech-tree-icons-value="<%= tech_tree_icons(@tech_paths).to_json %>"
    >
      <div class="tech-tree__graph" data-tech-tree-target="graph"></div>
      <div class="tech-tree__tooltip" data-tech-tree-target="tooltip" hidden></div>
    </div>
  <% end %>
</div>