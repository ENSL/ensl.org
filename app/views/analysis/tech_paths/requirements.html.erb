<%= link_to 'Back', analysis_root_path, class: 'analysis-back' %>
<h1 class="title">NS1 Marine Tech tree</h1>

<div class="wide tech-requirements">
  <p>Marine research and building prerequisites, with observed research results where log data is available.</p>
  <p class="text-sm text-gray-600">
    Based on <%= number_with_delimiter(@rounds_analysed) %> finished rounds; showing recorded research results where available.
  </p>

  <%= form_with url: analysis_tech_requirements_path, method: :get, local: true do %>
    <p class="analysis-filters">
      <span>
        <%= label_tag :min_rounds, 'Minimum samples:' %>
        <%= select_tag :min_rounds,
                       options_for_select(@min_rounds_options.map { |n| [n, n] }, @selected_min_rounds),
                       onchange: 'this.form.requestSubmit()' %>
      </span>
    </p>
  <% end %>

  <div
    data-controller="static-tech-tree"
    data-static-tech-tree-diagram-value="<%= tech_requirement_tree_diagram %>"
    data-static-tech-tree-nodes-value="<%= tech_requirement_tree_nodes(@tech_paths, @rounds_analysed, min_rounds: @selected_min_rounds).to_json %>"
  >
    <div class="tech-requirements__graph" data-static-tech-tree-target="graph"></div>
    <div class="tech-requirements__tooltip" data-static-tech-tree-target="tooltip" hidden></div>
  </div>
</div>