<h1 class="title">Player rankings</h1>

<div class="box wide">
  <p>
    Skill ratings and win/loss stats from the most recent analysis batch.
    Click a column header to sort.
  </p>

  <%= form_with url: analysis_users_path, method: :get, local: true do %>
    <p>
      <%= label_tag :min_games, 'Minimum games:' %>
      <%= select_tag :min_games,
                     options_for_select(@min_games_options.map { |n| [n, n] }, @selected_min_games),
                     onchange: 'this.form.requestSubmit()' %>
    </p>
  <% end %>

  <% if @rankings.empty? %>
    <p>No analysis results are available yet.</p>
  <% else %>
    <%
      skill_display_multiplier = {
        skill_dl: 10_000,
        skill_mlt: 100,
        skill_os_btf: 100
      }

      format_number = lambda do |value, precision: 2|
        value.nil? ? '–' : number_with_precision(value, precision: precision)
      end

      skill_column = lambda do |key, label|
        multiplier = skill_display_multiplier.fetch(key, 1)
        {
          key: key,
          label: label,
          type: :number,
          sort_value: ->(value) { value.nil? ? nil : (value * multiplier) },
          format: ->(value) { value.nil? ? '–' : format_number.call(value * multiplier, precision: 0) }
        }
      end

      columns = [
        {
          key: :user,
          label: 'Player',
          type: :string,
          sort_value: ->(user) { user.to_s.downcase },
          format: ->(user) { namelink(user) }
        },
        { key: :wins, label: 'Wins', type: :number, format: ->(value) { value&.to_i } },
        { key: :losses, label: 'Losses', type: :number, format: ->(value) { value&.to_i } },
        {
          key: :win_ratio,
          label: 'Win ratio %',
          type: :number,
          sort_value: ->(value) { value.nil? ? nil : (value * 100) },
          format: ->(value) { value.nil? ? '–' : format_number.call(value * 100, precision: 0) }
        },
        skill_column.call(:skill_dl, 'Skill (DL x10000)'),
        skill_column.call(:skill_mlt, 'Skill (MLT x100)'),
        skill_column.call(:skill_os_btf, 'Skill (OS BradleyTerryFull x100)')
      ]
    %>

    <%= sortable_table(columns: columns, rows: @rankings, id: 'player-rankings') %>
  <% end %>
</div>
