<% if messages && messages.any? %>
  <% error_container_id = local_assigns[:container_id] || 'errors' %>
  <div id="<%= error_container_id %>" class="errors-block">
    <strong><%= t('errors.template.header', default: 'Please review the following errors:') %></strong>

    <ul class="errors">
      <% messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
