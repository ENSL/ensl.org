<%= provide :content_class, 'no-body' %>

<div id="categories">
  <% @categories.each do |cat| %>
    <% forums = cuser ? cat.forums.available_to(cuser, Forumer::ACCESS_READ).ordered : cat.forums.public_forums.ordered %>
    <% next if forums.length == 0 %>

    <div class="category">
      <table class="category striped table-auto">
        <thead>
          <tr>
            <th colspan="2" class="category"><%=h cat.name %></th>
            <th class="actions w-[10%] text-center"></th>
            <th class="topics w-[10%]">Topics</th>
            <th class="posts w-[10%]">Posts</th>
            <th class="last w-[15%]">Last Post</th>
          </tr>
        </thead>

        <% forums.each do |forum| %>
          <tr>
            <td class="bullet w-[10%] <%= 'updated' if cuser and !cuser.have_read?(forum) %>"></td>
            <td class="forum w-[45%] pr-[10px]">
              <h5><%= namelink(forum) %></h5>
              <%= forum.description %>
            </td>
            <td class="actions w-[10%] text-center">
              <% if forum.can_update? cuser %>
                <%= link_to up_forum_path(forum), method: :patch do %>
                  <% fa_icon 'arrow-up' %>
                <% end %>
                <%= link_to down_forum_path(forum), method: :patch do %>
                  <% fa_icon 'arrow-down' %>
                <% end %>
              <% end %>
            </td>
            <td class="topics w-[10%]"><%= forum.topics.count %></td>
            <td class="posts w-[10%]"><%= forum.posts.count %></td>
            <td class="last w-[15%]">
              <% if forum.posts.last %>
                <%= link_to lastpost(forum.posts.last.topic) do %>
                  <%=h forum.posts.last.user %><br>
                  <%= shortdate(forum.posts.last.created_at) %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>

<div class="statistics">
  <h4>Statistics</h4>
  <p>
    We have total of <strong><%= Post.count %></strong> posts,
    <strong><%= Topic.count %></strong> topics, and <strong><%= User.count %></strong> users.
  </p>
  <p>
    Our newest member is <%= namelink User.last %> and most active member is <%= namelink User.posts_stats(1).first %>.
  </p>
</div>

<% if Forum.new.can_create? cuser %>
  <p class="forum-index-controls">
    <%= link_to 'New Forum', new_forum_path, class: 'button' %>
  </p>
<% end %>
