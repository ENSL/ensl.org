<h1>
  Editing Movie
</h1>

<%= render 'form', movie: @movie, movie_categories: @movie_categories %>

<div class="preview">
  <h3>Make a Preview</h3>

  <p>
    This will produce a MP4-version preview of the file. It will take usually 3-4 times the movie length.
    The program will run in the background and the preview file will automatically added to the movie.
  </p>

  <%= form_tag(preview_movie_path(@movie.id), { class: 'square' }) do %>
    <div class="fields horizontal">
      <%= label_tag :web_friendly, 'Web Friendly' %>
      <div class="inputs">
        <div class="status">
          <% if @movie.web_friendly %>
            <span class="icon success"><%= fa_icon('check') %></span>
            <span class="status-text">The original format plays nicely in browser</span>
          <% else %>
            <span class="icon muted"><%= fa_icon('times') %></span>
            <span class="status-text muted">The video requires a preview version in web-friendly format</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="fields horizontal">
      <%= label_tag :format, 'Format' %>
      <div class="inputs">
        <p class="note">
          The dimensions and FPS are the same. It uses x264 codec, YUV420p colorspace, and targets
          high quality (crf 18), not bitrate.
        </p>
      </div>
    </div>

    <div class="fields horizontal">
      <%= label_tag :existing_preview, 'Existing Preview' %>
      <div class="inputs">
        <div class="status">
          <% if @movie.preview_exists? %>
            <span class="icon success"><%= fa_icon('check') %></span>
            <span class="status-text"><%= link_to 'Preview exists', @movie.preview_url, target: '_blank' %></span>
          <% else %>
            <span class="icon muted"><%= fa_icon('times') %></span>
            <span class="status-text muted">Preview doesn&apos;t exist</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="controls">
      <%= submit_tag "Make a Preview" %>
    </div>
  <% end %>
</div>


<div class="snapshot">
  <h3>Take a Snapshot</h3>

  <%= form_tag({ action: "snapshot", id: @movie.id }, { class: 'square' }) do %>
    <div class="fields horizontal">
      <%= label_tag "Seconds" %>
      <%= text_field_tag "secs" %>
    </div>

    <div class="controls">
      <%= submit_tag "Take Snapshot" %>
    </div>
  <% end %>
</div>

<div class="stream">
  <h3>Download (Stream)</h3>

  <%= form_tag({ action: "download", id: @movie.id }, { class: 'square' }) do %>
    <p>This will start downloading the video from an IP and Port.</p>

    <div class="fields horizontal">
      <%= label_tag "IP" %>
      <%= text_field_tag "ip", "", size: 12 %>
    </div>

    <div class="fields horizontal">
      <%= label_tag "Port" %>
      <%= text_field_tag "port", "", size: 3 %>
    </div>

    <div class="controls">
      <%= submit_tag "Download" %>
    </div>
  <% end %>
</div>

