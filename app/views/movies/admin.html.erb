<div class="admin movies">
  <h1 class="title">Movies Admin</h1>

  <table class="striped">
    <tr>
      <th>Title</th>
      <th>Submitter</th>
      <th>Created</th>
      <th>Length</th>
      <th>File</th>
      <th>Web</th>
      <th>Preview</th>
      <th class="actions"></th>
    </tr>

    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.to_s, movie %></td>
        <td><%= movie.user ? namelink(movie.user) : '-' %></td>
        <td><%= shorttime movie.created_at %></td>
        <td><%= movie.length_s %></td>
        <td>
          <% if movie&.file.file_exists? %>
            <span style="color:#1f7f5c"><%= fa_icon('check') %></span>
          <% else %>
            <span style="color:#9aa0a6"><%= fa_icon('times') %></span>
          <% end %>
        </td>
        <td>
          <% if movie.preview_url.present? || movie.web_friendly %>
            <span style="color:#1f7f5c"><%= fa_icon('check') %></span>
          <% else %>
            <span style="color:#9aa0a6"><%= fa_icon('times') %></span>
          <% end %>
        </td>
        <td>
          <% if movie.preview_url.present? %>
            <%= link_to fa_icon('eye', class: "green"), movie.preview_url, target: '_blank', title: 'View preview' %>
          <% else %>
            <%= link_to fa_icon('video', class: "red"), preview_movie_path(movie), method: :post, title: 'Make preview', form: { style: 'display:inline;margin:0;' } %>
          <% end %>
        </td>
        <td class="actions">
          <%= link_to fa_icon('pencil'), edit_movie_path(movie) %>
          <%= link_to fa_icon('times'), movie, data: { confirm: 'Are you sure?' }, method: :delete %>
        </td>
      </tr>
    <% end %>
  </table>
</div>
