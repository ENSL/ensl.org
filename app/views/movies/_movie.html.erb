<table class="movie">
  <% user = movie.user %>
  <% file = movie.file %>
  <% snapshot_url = movie.snapshot_url %>
  <% movie_files = params[:action] == "show" ? movie.all_files : [file] %>
  <tr>
    <td>
      <% if movie.picture %>
        <%= image_tag snapshot_url, :class => "w-90 h-auto" %>
      <% end %>
    </td>

    <td>
      <h3 class="title"><%= namelink movie %></h3>
      <% if user %>
        <dl>
          <dt>Author</dt>
          <dd><%= link_to user.username, movies_url(author: movie.user_id) %></dd>
        </dl>
      <% end %>
      <%= cascade movie, ["content", "format", "length_s", ["Views", "view_count"], ["Date", "file.created_at"]] %>

      <% movie_files.each do |movie_file| %>
      <% unless movie_file.nil? %>
          <b>File: </b>
          <% if movie_file.file_exists? %>
            <%= link_to File.basename(movie_file.name.to_s), movie_file.url %>
          <% else %>
            <span class="muted"><%= File.basename(movie_file.name.to_s) %> (missing)</span>
          <% end %>
          <ul>
            <li>
              <strong>MD5:</strong> <%= movie_file.md5_s %>
            </li>
            <li>
              <strong>Size:</strong> <%= movie_file.size_s %> MB
            </li>
          </ul>
        <% end %>
      <% end %>

      <% if cuser and movie.can_update? cuser %>
        <div class="controls">
          <%= link_to 'Edit', edit_movie_path(movie), class: 'button tiny' %>
          <%= link_to 'Make a Preview', preview_movie_path(movie), method: :post, class: 'button tiny' %>
          <% if movie.can_destroy? cuser %>
            <%= button_to 'Destroy', movie_path(movie),
                          method: :delete,
                          form: { class: 'inline' },
                          class: 'button tiny',
                          data: { turbo_confirm: 'Are you sure?' } %>
          <% end %>
        </div>
      <% end %>
    </td>
  </tr>
</table>
