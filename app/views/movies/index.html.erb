<div id="movies">
  <h1 class="title">Movie Archive</h1>
  <p>
    We recommend <%= link_to "VLC Player", "http://www.videolan.org/vlc/" %> for movie playback.
    <% can_create_movie = Movie.new.can_create?(cuser) %>
    <% can_upload_movie_file = cuser && DataFile.new(directory_id: Directory::MOVIES).can_create?(cuser) %>
    <% if can_create_movie %>
      You can add a movie <%= link_to "here", new_movie_path %> from an existing file on server.
    <% end %>
    <% if can_upload_movie_file %>
      Or you can use <%= link_to "movie file upload", new_data_file_path(id: Directory::MOVIES) %>.
    <% end %>
    <% if !can_create_movie && !can_upload_movie_file %>
      Ask admins if you'd like to upload NS1/NS2 movies. We'll provide access.
    <% end %>
  </p>

  <div class="filters">
    <%= form_tag movies_url, method: "get" do %>
      <div class="fields">
        <%= select_tag :rating, options_for_select([['All', ''], ['5 stars', 5], ['4 stars', 4], ['3 stars', 3], ['2 stars', 2], ['1 star', 1]], params[:rating]), onchange: 'this.form.submit()' %>
      </div>

      <div class="fields">
        <%= select_tag :order, options_for_select({"Ratings" => 'ratings', "Date" => 'date', "Author" => 'author'}, params[:order]), onchange: 'this.form.submit()' %>
      </div>

      <div class="fields">
        <%= select_tag :author, options_for_select([['All Authors', '']] + ( @movie_authors || [] ), params[:author]), onchange: 'this.form.submit()' %>
      </div>
    <% end %>

    <% @movie_size_categories.each do |category_name| %>
      <% active = params[:size] == category_name %>
      <%= link_to category_name,
        movies_url(size: (active ? nil : category_name), order: params[:order], rating: params[:rating], author: params[:author]),
        class: "button mr-2 #{'opacity-50 bg-gray-200 text-gray-700' if active}" %>
    <% end %>
  </div>

  <div class="w-full">
    <div id="movies-grid"
        class="grid gap-5 w-max mx-auto [grid-template-columns:repeat(5,10rem)]">

      <% @movies.each do |movie| %>

        <%= link_to movie_path(movie),
            class: "group relative w-40 h-32 overflow-hidden rounded bg-gray-100" do %>

          <!-- Image / Icon Layer -->
          <div class="absolute inset-0 transition-opacity duration-300 group-hover:opacity-0">

            <% if movie.picture? %>
              <%= image_tag movie.picture.url,
                  class: "w-full h-full object-cover" %>
            <% elsif movie.snapshot? %>
              <%= image_tag movie.snapshot_url,
                  :class => "w-full h-full object-cover" %>
            <% else %>
              <div class="flex items-center justify-center w-full h-full">
                <i class="fa-solid fa-film text-3xl text-gray-400"></i>
              </div>
            <% end %>

          </div>

          <!-- Hover Details Layer -->
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-2
                      opacity-0 transition-opacity duration-300
                      group-hover:opacity-100 bg-white/90">

            <div class="font-semibold text-sm">
              <%= movie.to_s %>
            </div>

            <div class="text-xs text-gray-600">
              <%= movie&.user %>
            </div>

          </div>

        <% end %>

      <% end %>

    </div>
  </div>
</div>
