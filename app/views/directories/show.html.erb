<h1 class="title">Files</h1>

<p>
<% if @directory.root? %>
  In case there are any problems with this browser, you can find files
  <%= link_to "here", "/files/" %>
  too.
<% end%>
</p>

<%
  active = 1
  n = 1
%>

<div id="files" class="tabbed">
  <ul id="files-nav" class="tabs">
    <% @directories.each do |dir| %>
      <li><a href="#dir_<%= dir.id %>"><%= h dir.title %></a></li>
    <% end %>
  </ul>

  <div class="tabbed-contents">
    <% @directories.each do |dir| %>
      <div class="tab" id="dir_<%= dir.id %>">
        <%
          if @directory.full_path.include?(dir.full_path)
            dir = @directory
            active = n
          end
          n = n + 1
        %>

        <div class="directories">
        <% if !dir.parent_root? %>
          <h3><%= directory_links @directory %></h3>
        <% end %>
        <% if dir.description.present? %>
          <p><%= dir.description %></p>
        <% end %>
          <h3>Sub-directories</h3>
        <% if dir.subdirs.ordered.any? %>
            <div class="subdirectories">
              <ul class="disc">
                <% dir.subdirs.ordered.each do |subdir| %>
                  <li><%= link_to subdir.title, subdir %></li>
                <% end %>
              </ul>
            </div>
        <% else %>
          <p class="subdirectories empty">No sub-directories.</p>
        <% end %>
        </div>

        <h3>Files</h3>

        <% dir.files.unrelated.each do |file| %>
          <div class="file" id="file_<%= file.id %>">
            <div class="actions">
              <% if file.can_update? cuser %>
                <%= link_to fa_icon('pencil'), edit_data_file_path(file, return_to: directory_path(dir)),
                  class: 'edit-file', title: 'Edit file', aria: { label: 'Edit file' } %>
              <% end %>

              <% if file.can_destroy? cuser %>
                <%= link_to fa_icon('times'), file,
                  class: 'remove-file', title: 'Remove file', aria: { label: 'Remove file' },
                  data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
              <% end %>
            </div>

            <h4><%= namelink file %></h4>
            <p><%= h file.description %></p>

            <div class="comments">
              <%= fa_icon('fa-solid fa-ruler-vertical') %> <%= file.size_s %>
              <span class="file-modified"><%= fa_icon('clock') %> <%= shorttime file.created_at %></span>

              <% if file.related_files.count > 0 %>
                <%= link_to file do %>
                  <%= fa_icon('fa-solid fa-file-half-dashed') %> Related files (<%= file.related_files.count %>)
                <% end %>
              <% end %>

              <%= link_to file do %>
                <%= fa_icon('comments') %> Comments (<%= file.comments.count %>)
              <% end %>
            </div>

            <%= link_to file.url, class: 'button tiny' do %>
              <%= fa_icon('download', style: :solid) + " Download" %>
            <% end %>
          </div>
        <% end %>

        <% if dir.files.empty? %>
          <p>Empty directory.</p>
        <% end %>

        <% if cuser and cuser.admin? %>
          <div class="controls">
            <%= link_to "Edit Directory", edit_directory_path(dir), class: 'button' %>
            <%= link_to "Delete Directory", dir,  data: { confirm: "Are you sure?" }, method: 'delete', class: 'button' %>
            <%= link_to "New Directory", { controller: "directories", action: "new", id: dir }, { class: 'button' } %>
            <%= link_to "New File", { controller: "data_files", action: "new", id: dir }, { class: 'button' } %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script type="text/javascript">
  new Yetii({
    id: 'files',
    active: <%= active %>
  });
</script>
