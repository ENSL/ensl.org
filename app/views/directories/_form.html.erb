<div class="wide box">
  <%= form_for @directory, html: { class: "square" } do |f| %>
    <div id="<%= dom_id(@directory) %>_errors_wrapper">
      <%= render 'shared/errors', messages: @directory.errors.full_messages, container_id: "#{dom_id(@directory)}_errors" %>
    </div>
    
    <% if @directory.new_record? %>
      <%= f.hidden_field :parent_id %>
    <% end %>

    <div class="fields horizontal">
      <label><strong>Parent:</strong></label>
      <div class="inputs">
        <%= @directory.parent.full_path %>
      </div>
    </div>

    <div class="fields horizontal">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>

    <div class="fields horizontal">
      <%= f.label :title %>
      <%= f.text_field :title %>
    </div>

    <div class="fields horizontal">
      <%= f.label :hidden %>
      <%= f.check_box :hidden %>
      <%= f.label :hidden, class: 'checkbox' do %>
        Hide directory from public listings
      <% end %>
    </div>

    <div class="controls submit-field">
      <%= f.submit %>
    </div>
  <% end %>
</div>
