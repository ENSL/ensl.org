<div id="custom-urls-panel">
  <h1 class="fancy"><span>Custom URLs - Admin Panel</span></h1>
  <div>
    <table id="custom-urls" class="striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Article</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @custom_urls.each do |url| %>
          <%= render 'custom_url_row', url: url, articles_for_select: @articles_for_select, row_class: cycle('odd', 'even') %>
        <% end %>
      </tbody>
    </table>
    <% if @custom_url.errors.any? %>
      <%= render 'shared/errors', messages: @custom_url.errors.full_messages %>
      <br>
    <% end %>
    <%= form_for @custom_url, html: { class: 'custom-url-new-form square' } do |f| %>
        <div class="fields horizontal">
          <%= f.label :name, 'Name' %>
          <div class="inputs">
            <%= f.text_field :name, placeholder: 'Name', aria: { label: 'Name' } %>
          </div>
        </div>
        <div class="fields horizontal">
          <%= f.label :article_id, 'Article' %>
          <div class="inputs">
            <div class="select-wrapper">
              <%= f.select :article_id, @articles_for_select, {}, { aria: { label: 'Article' }, title: 'Article' } %>
            </div>
          </div>
        </div>
        <div class="controls">
          <%= f.submit 'Add' %>
        </div>
  <% end %>
  </div>
</div>
