<div id="custom-urls-panel">
  <h1 class="fancy"><span>Custom URLs - Admin Panel</span></h1>
  <div>
    <p>Don't delete custom URLs linked from the menu!</p>
  </div>
  <div>
    <table id="custom-urls" class="striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Article</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @custom_urls.each do |url| %>
          <tr class="<%= cycle('odd', 'even') %>" id="<%= url.id %>">
            <td class="name"><%= url.name %></td>
            <td class="article"><%= url.article.title %></td>
            <td>
              <%= link_to fa_icon('pencil'), '#', onclick: "showEdit(#{url.id}); return false;" %>
              <%= link_to fa_icon('times'), custom_url_path(url), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this item?' } %>
            </td>
            <td class="edit hidden" colspan="3">
              <%= form_for url do |f| %>
                <div class="fields">
                  <div class="inline">
                    <%= f.text_field :name %>
                  </div>
                  <div class="select-wrapper">
                    <%= f.select :article_id, @articles_for_select %>
                  </div>
                  <%= link_to 'Save', '#', onclick: "submitEdit(#{url.id}); return false;", class: 'button' %>
                </div>
            <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @custom_url.errors.any? %>
      <%= render 'shared/errors', messages: @custom_url.errors.full_messages %>
      <br>
    <% end %>
    <%= form_for @custom_url do |f| %>
        <div class="fields">
          <div class="inline">
            <%= f.text_field :name %>
          </div>
          <div class="select-wrapper">
            <%= f.select :article_id, @articles_for_select %>
          </div>
          <%= f.submit 'Add', class: 'button' %>
        </div>
  <% end %>
  </div>
</div>
