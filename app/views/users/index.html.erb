<h1 class="title">Listing Users</h1>
<p><%= User.lately.count %> players have signed in within the past 30 days.</p>
<%= link_to 'Show them', users_path(filter: 'lately'), class: 'button' %><br><br><br>

<p>Search for users by name or Steam ID:</p>

<%= form_tag(users_path, method: 'get', class: 'square search flex items-start gap-x-2') do %>
  <%= hidden_field_tag :direction, params[:direction] %>
  <%= hidden_field_tag :sort, params[:sort] %>
  <div class="fields query flex-1">
    <%= text_field_tag :search, params[:search], class: 'w-full' %>
  </div>
  <div class="controls">
    <%= submit_tag "Search", name: nil %>
  </div>
<% end %>

<%= will_paginate @users %>

<table id="users" class="striped table-auto">
  <tr>
    <th class="country w-[7%]"></th>
    <th class="username w-[30%]">Username</th>
    <th class="name w-[30%]">Name</th>
    <th class="steamid w-1/5">Steam ID</th>
    <th class="age w-[5%]">Age</th>
    <% if cuser and cuser.admin? %>
      <th class="actions text-right"></th>
    <% end %>
  </tr>

  <% @users.each do |user| %>
    <tr>
      <td><%= flag user.country %></td>
      <td><%= link_to (h user.username), user %></td>
      <td><%= h user.firstname %> <%=h user.lastname %></td>
      <td><%= h user.steamid %></td>
      <td><%= user.age %></td>
      <% if cuser and cuser.admin? %>
        <td class="actions text-right">
          <%= link_to edit_user_path(user) do %>
            <%= fa_icon 'pencil' %>
          <% end %>
          <%= link_to user, confirm: "Proceed to delete?", method: :delete do %>
            <%= fa_icon 'times' %>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
</table>

<%= will_paginate @users %>
