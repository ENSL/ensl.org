<h3 class="center">
  <%= namelink @user.username %>
</h3>

<table class="data">
  <tr>
    <th>Username</th>
    <th>SteamID</th>
    <th>Last IP</th>
    <th>Date</th>
  </tr>
  <% @user.versions.reorder(created_at: :desc, id: :desc).each do |version| %>
    <% user = version.reify %>
    <% next unless user %>
    <tr>
      <td><%= h user.username %></td>
      <td><%= h user.steamid %></td>
      <td><%= h user.lastip %></td>
      <td><%= shorttime version.created_at %></td>
    </tr>
  <% end %>
</table>
