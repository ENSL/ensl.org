<div class="flex gap-x-5">
  <div class="group">
  <h4>General information</h4>
  <% profile = user.profile %>
  <% groups = user.groups %>
  <% teamers = user.teamers.active %>

  <dl>
    <dt>Age</dt>
    <dd><%= user.age %></dd>

    <% if !user.country.blank? %>
      <dt>Country</dt>
      <dd><%= user.country %></dd>
    <% end %>

    <% if !profile.town.blank? %>
      <dt>Town</dt>
      <dd><%= profile.town %></dd>
    <% end %>

    <% if !user.steamid.blank? %>
      <dt>SteamID</dt>
      <dd>
        <p><%= user.steamid %></p>
        <div id="steam-search" data-user-id="<%= user.id %>">
          <%= link_to "Search for Steam Account" %>
        </div>
      </dd>
    <% end %>

    <% if !profile.stream.blank? %>
      <dt>Stream</dt>
      <dd><%= profile.stream %></dd>
    <% end %>
  </dl>

  <h4>Contact</h4>

  <dl>
    <% if !profile.web.blank? %>
      <dt>Web</dt>
      <dd><%= profile.web %></dd>
    <% end %>

    <% if cuser and cuser.admin? or user.public_email %>
      <dt>Email</dt>
      <dd><%= user.email_s %></dd>
    <% end %>

    <% if profile.steam_profile? %>
      <dt>Steam</dt>
      <dd>
        <% if profile.steam_profile.match(/\A[0-9]*\z/) %>
          <%= link_to profile.steam_profile, "http://steamcommunity.com/profiles/#{profile.steam_profile}" %>
        <% elsif profile.steam_profile.match(/\A[A-Za-z0-9_\-\+]{1,40}\z/) %>
          <%= link_to profile.steam_profile, "http://steamcommunity.com/id/#{profile.steam_profile}" %>
        <% end %>
      </dd>
    <% end %>
  </dl>

  <% if profile.achievements and !profile.achievements.empty? %>
    <h4>Achievements</h4>
    <div class="achievements">
      <%= sanitize(profile.achievements_parsed) %>
    </div>
  <% end %>

  <% if cuser && Message.new.can_create?(cuser) && user != cuser %>
    <%= link_to "Send PM", { controller: "messages", action: "new", id: "User", id2: user }, { class: 'button tiny' } %>
  <% end %>
  </div>

  <div class="group">
  <h4>Statistics</h4>

  <dl>
    <dt>Joined</dt>
    <dd><%= longtime user.created_at %></dd>
    <dt>Last visit</dt>
    <dd><%= longtime user.lastvisit %></dd>
    <dt></dt>

    <% if cuser and cuser.admin? %>
      <dt>Last IP</dt>
      <dd><%= user.lastip %></dd>
    <% end %>

    <dt>Comments</dt>
    <dd><%= user.posted_comments.count %></dd>
    <dt>Matches</dt>
    <dd><%= user.matches.count %></dd>

    <% if groups.count > 0 %>
      <dt>Groups</dt>
      <% for group in groups.all %>
        <dd><%= namelink group %></dd>
      <% end %>
    <% end %>

    <% if teamers.count > 0 %>
      <dt>Teams</dt>
      <% teamers.each do |teamer| %>
        <dd><%= namelink teamer.team %></dd>
      <% end %>
    <% end %>
  </dl>
  </div>
</div>