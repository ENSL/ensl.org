<div class="players">
  <% contester.lineup.each do |teamer| %>
    <div class="player fields">
      <% if matcher = match.matchers.where(user_id: teamer.user_id, contester_id: contester.id).first %>
        <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][id]", matcher.id %>
      <% end %>

      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][user_id]", teamer.user_id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][contester_id]", contester.id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][match_id]", match.id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][merc]", false %>
      <%= check_box_tag "match[matchers_attributes][#{counter[0]}][_destroy]", "keep", !matcher.nil?, { id: "player_#{counter[0]}" } %>

      <%= label_tag "player_#{counter[0]}", '', class: 'checkbox' %>

      <span><%= teamer.user %></span>
    </div>

    <% counter[0] = counter[0] + 1 %>
  <% end %>
</div>

<div class="mercenaries">
  <% match.matchers.mercs.of_contester(contester).each do |matcher| %>
    <div class="player fields">
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][id]", matcher.id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][user_id]", matcher.user_id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][contester_id]", contester.id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][match_id]", match.id %>
      <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][merc]", true %>
      <%= check_box_tag "match[matchers_attributes][#{counter[0]}][_destroy]", "keep", true, { id: "player_#{counter[0]}" } %>

      <%= label_tag "player_#{counter[0]}", '', class: 'checkbox' %>

      <span><%= matcher.user %></span>
    </div>

    <% counter[0] = counter[0] + 1 %>
  <% end %>

  <div class="fields">
    <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][contester_id]", contester.id %>
    <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][match_id]", match.id %>
    <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][merc]", true %>
    <%= hidden_field_tag "match[matchers_attributes][#{counter[0]}][_destroy]", "keep" %>

    <%= text_field_tag "match[matchers_attributes][#{counter[0]}][user_id]", '', placeholder: 'Mercenary' %>

    <% counter[0] = counter[0] + 1 %>
  </div>
</div>
