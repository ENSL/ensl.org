<table id="matches" class="<%= 'contest' if defined? contest and contest %> striped">
  <% list_friendly = local_assigns[:friendly] %>
  <% show_contest_column = defined?(contest) && contest %>
  <% max_columns_allow_points = !defined?(max_columns) || max_columns > 4 %>
  <% show_points = max_columns_allow_points && matches.any? { |m| m.contest&.contest_type == Contest::TYPE_LADDER } %>
  <tr>
    <% if show_contest_column %>
      <th class="contest">Contest</th>
      <th class="opponent">Opponent</th>
    <% else %>
      <th class="opponent">Opponent</th>
    <% end %>
    <th class="date">Date</th>
    <% unless defined? exclude_maps %>
      <th class="maps">Maps</th>
    <% end %>
    <% if show_points %>
      <th class="points">Points</th>
    <% end %>
    <th class="score">Score</th>
  </tr>

  <% matches.each do |match| %>
    <% match_contest = match.contest %>
    <% opponent_team = match_list_opponent_team(match, list_friendly) %>
    <% score_class = "bold #{match_list_score_color(match)}" %>
    <% score_text = match_list_score_text(match) %>
    <tr>
      <% if show_contest_column %>
        <td>
          <%= namelink match_contest %>
        </td>
      <% end %>
      <td>
        <%= namelink opponent_team %>
      </td>
      <td>
        <%= shorttime match.match_time %>
      </td>
      <% unless defined? exclude_maps %>
        <td>
          <%= match.map1 %>, <%= match.map2 %>
        </td>
      <% end %>
      <% if show_points %>
        <td class="points">
          <% if match_contest&.contest_type == Contest::TYPE_LADDER %>
            <% points = match.points1 %>
            <% if points.to_i > 0 %>
              <%= fa_icon 'chevron-up' %>
            <% elsif points.to_i < 0 %>
              <%= fa_icon 'chevron-down' %>
            <% end %>
            <%= points %>
          <% end %>
        </td>
      <% end %>
      <td class="score">
        <%= link_to score_text, match, class: score_class %>
      </td>
    </tr>
  <% end %>
</table>
