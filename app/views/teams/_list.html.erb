<table class="striped table-auto">
  <tr>
    <th class="country w-[7%]"></th>
    <th class="name w-[45%]">Name</th>
    <th class="irc w-[25%]">IRC</th>
    <th class="members w-[10%]">Members</th>
    <% if cuser and cuser.admin? %>
      <th class="actions w-[15%] text-right"></th>
    <% end %>
  </tr>

  <% for team in teams %>
      <tr>
        <td><%= flag team.country %></td>
        <td><%= namelink team %></td>
        <td><%= h team.irc if team.irc %></td>
        <td><%= h team.teamers.count %></td>
        <% if cuser and cuser.admin? %>
          <td class="actions w-[15%] text-right">
            <%= link_to edit_team_path(team) do %>
              <%= fa_icon 'pencil' %>
            <% end %>
            <% if team.active %>
              <%= link_to team_path(team), data: { confirm: 'Are you sure?' }, method: :delete do %>
                <%= fa_icon 'times' %>
              <% end %>
            <% else %>
              <%= link_to recover_team_path(team) do %>
                <%= fa_icon 'save' %>
              <% end %>
            <% end %>
          </td>
        <% end %>
      </tr>
  <% end %>
</table>
